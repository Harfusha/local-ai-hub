{
  "local-ai-hub": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/run_hub.py antigravity_hook SessionStart",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [{
          "type": "command",
          "command": "python ./scripts/run_hub.py antigravity_hook PreToolUse",
          "timeout": 15
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [{
          "type": "command",
          "command": "python ./scripts/run_hub.py antigravity_hook PostToolUse",
          "timeout": 15
        }]
      }
    ]
  }
}
