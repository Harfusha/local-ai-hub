{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "rootDir": "src/local_ai_hub/ui_static",
    "outDir": "src/local_ai_hub/ui_static/dist",
    "skipLibCheck": true
  },
  "include": ["src/local_ai_hub/ui_static/**/*.ts", "src/local_ai_hub/ui_static/**/*.d.ts"]
}
