+def test_repo_search_output_contract_types_hits_and_keeps_diagnostics_optional():
+    from local_ai_hub.operation_contracts import (
+        operation_tool_output_schema,
+        validate_operation_output,
+    )
+
+    hit = {
+        "path": "src/main.py",
+        "start_line": 2,
+        "end_line": 3,
+        "score": 4.5,
+        "text": "2: needle()\n3: return True",
+        "file_sha256": "a" * 64,
+    }
+    result = {
+        "success": True,
+        "root": "C:/repo",
+        "results": [hit],
+        "scanned_files": 1,
+        "terms": ["needle"],
+        "engine": "ripgrep",
+        "candidate_context_tokens_est": 17,
+    }
+    assert validate_operation_output("local_ai_repo", "search", result) is None
+    assert validate_operation_output(
+        "local_ai_repo", "search", {**result, "preprocessed_hit": True, "progressive_disclosure": True}
+    ) is None
+    for field, invalid in (
+        ("path", 17),
+        ("start_line", "line one"),
+        ("end_line", "3"),
+        ("score", "high"),
+        ("text", None),
+    ):
+        invalid_result = {**result, "results": [{**hit, field: invalid}]}
+        assert validate_operation_output("local_ai_repo", "search", invalid_result) is not None, field
+    for field in ("preprocessed_hit", "progressive_disclosure"):
+        assert validate_operation_output("local_ai_repo", "search", result) is None
+        assert validate_operation_output(
+            "local_ai_repo", "search", {**result, field: "yes"}
+        ) is not None
+
+    output_schema = operation_tool_output_schema("local_ai_repo")
+    assert output_schema["additionalProperties"] is True
+    assert "anyOf" not in output_schema
+    search_delta = output_schema["x-action-output-contracts"]["search"]
+    result_item = search_delta["properties"]["results"]["items"]
+    assert result_item["properties"]["start_line"] == {"type": "integer"}
+    assert "preprocessed_hit" not in search_delta.get("required", [])
+    assert "progressive_disclosure" not in search_delta.get("required", [])
