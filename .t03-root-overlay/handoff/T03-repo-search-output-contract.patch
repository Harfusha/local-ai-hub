+def _output_payload_delta(schema: dict[str, Any]) -> dict[str, Any]:
+    """Project action payload fields without repeating the shared MCP envelope."""
+    def strip_envelope(value: Any) -> Any:
+        if isinstance(value, list):
+            return [strip_envelope(item) for item in value]
+        if not isinstance(value, dict):
+            return value
+        projected: dict[str, Any] = {}
+        for key, item in value.items():
+            if key in {"title", "description"}:
+                continue
+            if key == "properties" and isinstance(item, dict):
+                payload_properties = {
+                    name: strip_envelope(prop)
+                    for name, prop in item.items()
+                    if name not in _OUTPUT_ENVELOPE_FIELDS
+                }
+                if payload_properties:
+                    projected[key] = payload_properties
+                continue
+            if key == "required" and isinstance(item, list):
+                payload_required = [name for name in item if name not in _OUTPUT_ENVELOPE_FIELDS]
+                if payload_required:
+                    projected[key] = payload_required
+                continue
+            if key in {"anyOf", "oneOf", "allOf"} and isinstance(item, list):
+                branches = [strip_envelope(branch) for branch in item]
+                branches = [
+                    branch for branch in branches
+                    if isinstance(branch, dict)
+                    and ("properties" in branch or "required" in branch or "anyOf" in branch or "oneOf" in branch)
+                ]
+                if branches:
+                    projected[key] = branches
+                continue
+            projected[key] = strip_envelope(item)
+        return projected
+
+    delta = strip_envelope(schema)
+    if not isinstance(delta, dict):
+        return {}
+    if not any(key in delta for key in ("properties", "required", "anyOf", "oneOf", "allOf")):
+        return {}
+    return delta
 
 
