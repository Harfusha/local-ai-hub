{
  "schema_version": 1,
  "name": "decision-model",
  "task_type": "decision_model",
  "train_file": "../../../state/experiments/model-training/data/decision-train.jsonl",
  "evaluation_file": "../../../state/experiments/model-training/data/decision-eval.jsonl",
  "output_root": "../../../state/experiments/model-training/runs/decision-model",
  "system_prompt": "Return a decision object matching output_schema. Use only the supplied input.",
  "output_schema": {
    "type": "object",
    "properties": {
      "decision": {"type": "string"},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required": ["decision", "confidence"],
    "additionalProperties": false
  },
  "training": {
    "device": "cuda",
    "quantization": "4bit",
    "epochs": 3,
    "batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_length": 4096,
    "learning_rate": 0.0001,
    "gradient_checkpointing": true,
    "seed": 20261110
  },
  "benchmark": {"device": "cuda", "max_new_tokens": 128, "warmup_runs": 1},
  "lora": {"r": 16, "alpha": 32, "dropout": 0.05, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]},
  "models": [
    {"name": "replace-with-decision-model", "base_model": "REPLACE_WITH_HF_MODEL_ID_OR_LOCAL_PATH"}
  ]
}
