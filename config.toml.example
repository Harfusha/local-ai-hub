# Local AI Hub — example user configuration.
# Copy this file to config.toml and adjust for your machine.
# Full reference with all defaults: defaults.toml

[hardware]
# "auto" detects OS/CPU/RAM/GPU and selects a profile automatically.
# Profiles: cpu | integrated | low | balanced | high | max
profile = "auto"
auto_tune = true

[models]
# Use 0.5B for preprocessing, 1.5B for quick/simple requests, 3B for ordinary and more involved work, and 7B for the hardest reasoning.
# Check installed aliases with Ollama /api/tags or llama.cpp /models.
# fast_code = "qwen2.5-coder:1.5b"
# heavy_code = "qwen2.5-coder:3b"
# reasoning = "qwen2.5-coder:7b"
# background_code = "qwen2.5-coder:0.5b"
# general = "qwen2.5-coder:3b"
# Vision model follows hardware profile: qwen3.5:9b on balanced/high/max,
# qwen3-vl:4b on cpu/integrated/low. Override only when needed.

# Optional local llama.cpp SYCL model router for Intel GPU inference. It listens
# on loopback port 12438 and loads one model at a time. Auto-routing applies on
# Intel-only systems when all model aliases are configured; otherwise Ollama runs.
[llama_cpp]
mode = "auto" # off | auto (external only) | on (managed install; use when Ollama is disabled)
model_load_timeout_seconds = 600
managed_model_filename = "hub-qwen-15.gguf"
fallback_to_ollama = true

[llama_cpp.models."qwen2.5-coder:0.5b"]
url = "http://127.0.0.1:12438"
served_model = "hub-qwen-05"
context_length = 16384

[llama_cpp.models."qwen2.5-coder:1.5b"]
url = "http://127.0.0.1:12438"
served_model = "hub-qwen-15"
context_length = 32768

[llama_cpp.models."qwen2.5-coder:3b"]
url = "http://127.0.0.1:12438"
served_model = "hub-qwen-3"
context_length = 32768

[llama_cpp.models."qwen2.5-coder:7b"]
url = "http://127.0.0.1:12438"
served_model = "hub-qwen-7"
context_length = 32768

[code_intelligence]
# Enable Serena (semantic symbols) and CodeGraphContext (call/dependency graphs).
enabled = true
serena_enabled = true
codegraph_enabled = true
# Increase timeout for large projects (default 120s may not be enough for big Unity repos)
index_timeout_seconds = 1200
# direct_agent_mcp = false

[agents]
# Enable MCP config injection for supported agents.
codex = true
claude = true
gemini = true
# cursor = true
# windsurf = true
# vscode = true

[work_orchestrator]
# Closed-task delegation is intentionally serial by default; the integrated auto-profile
# further bounds queues/background work for shared-memory notebooks.
enabled = true
default_response_profile = "compact"
default_max_output_tokens = 1200
# max_pending_work_orders = 32
# worker_idle_seconds = 120
# max_steps = 32
# max_llm_steps = 16
# max_replans = 2

[security]
# Keep the hub bound to loopback unless you explicitly need remote access.
allow_remote = false
# api_token = "change-me-to-a-strong-random-token"   # required if allow_remote = true

[commands]
# Allow only read/validate commands by default.
allow_mutating = true
allow_unknown = true

[features]
tasks = true              # local model inference worker (local_ai_task)
vision = true             # image understanding/frontend review (set false to disable)
local_diagnostic_dispatch = true  # bounded L1 failure diagnosis; direct non-mutating validation commands only
enriched_search = true            # source-enriched repository search
batch_replacement = true          # atomic repository batch replacement
diagnostic_artifacts = true       # persist command diagnostic artifacts
rag = true                # semantic retrieval fallback (local_ai_rag)
commands = true           # safe command execution broker (local_ai_command)
coord = true              # coordination leases, memos, task contracts (local_ai_coord)
artifacts = true          # compact responses & evidence slicing (local_ai_artifact)
code_intelligence = true  # Serena / CodeGraphContext backends
preprocessing = true      # background idle project warmup
subagents = true          # advisory local profiles
agent_os = true           # durable execution: tasks, verification receipts, memory
dashboard = true          # realtime web dashboard at /dashboard
work_orchestrator = true  # whole-task plan/edit/verify/handoff (local_ai_work)

# After changing configuration, regenerate dynamic agent skills, instructions, and MCP schemas:
#   python tools/hubctl.py generate
#   or
#   python tools/setup.py --generate-only

# See defaults.toml for the complete list of options.
