# Local AI Hub — example user configuration.
# Copy this file to config.toml and adjust for your machine.
# Full reference with all defaults: defaults.toml

[hardware]
# "auto" detects OS/CPU/RAM/GPU and selects a profile automatically.
# Profiles: cpu | integrated | low | balanced | high | max
profile = "auto"
auto_tune = true

[models]
# Local Ollama models. Run ollama list to see available models.
# fast_code = "qwen2.5-coder:7b"
# heavy_code = "qwen2.5-coder:14b"
# reasoning = "qwen2.5-coder:14b"
# background_code = "qwen2.5-coder:3b"

[code_intelligence]
# Enable Serena (semantic symbols) and CodeGraphContext (call/dependency graphs).
enabled = true
serena_enabled = true
codegraph_enabled = true
# Increase timeout for large projects (default 120s may not be enough for big Unity repos)
index_timeout_seconds = 300
# direct_agent_mcp = false

[agents]
# Enable MCP config injection for supported agents.
codex = true
claude = true
gemini = true
# cursor = true
# windsurf = true
# vscode = true

[work_orchestrator]
# Closed-task delegation is intentionally serial by default; the integrated auto-profile
# further bounds queues/background work for shared-memory notebooks.
enabled = true
default_response_profile = "compact"
default_max_output_tokens = 350
# max_pending_work_orders = 32
# worker_idle_seconds = 120
# max_steps = 32
# max_llm_steps = 16
# max_replans = 2

[security]
# Keep the hub bound to loopback unless you explicitly need remote access.
allow_remote = false
# api_token = "change-me-to-a-strong-random-token"   # required if allow_remote = true

[commands]
# Allow only read/validate commands by default.
allow_mutating = false
allow_unknown = false

[features]
tasks = true              # local model inference worker (local_ai_task)
rag = true                # semantic retrieval fallback (local_ai_rag)
commands = true           # safe command execution broker (local_ai_command)
coord = true              # coordination leases, memos, task contracts (local_ai_coord)
artifacts = true          # compact responses & evidence slicing (local_ai_artifact)
code_intelligence = true  # Serena / CodeGraphContext backends
preprocessing = true      # background idle project warmup
subagents = true          # advisory local profiles
agent_os = true           # durable execution: tasks, verification receipts, memory
dashboard = true          # realtime web dashboard at /dashboard
work_orchestrator = true  # whole-task plan/edit/verify/handoff (local_ai_work)

# After changing configuration, regenerate dynamic agent skills, instructions, and MCP schemas:
#   python tools/hubctl.py generate
#   or
#   python tools/setup.py --generate-only

# See defaults.toml for the complete list of options.
