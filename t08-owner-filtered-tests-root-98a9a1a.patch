+    script = """
+import os
+import sys
+sys.path.insert(0, sys.argv[4])
+from local_ai_hub.agent_events import AgentStateStore
+from local_ai_hub.agent_tasks import GoalContract, ScopeContext, TaskStatus, TaskStore
+store = AgentStateStore(sys.argv[1])
