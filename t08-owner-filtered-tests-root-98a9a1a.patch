+        assert [event.kind for event in recovered_store.events(f"verification:{task_id}")].count(
+            "verification.receipt_recorded"
+        ) == 1
+        assert [event.kind for event in recovered_store.events(f"task:{task_id}")].count(
+            "task.verified"
+        ) == 1
