diff --git a/tests/test_t05_migration_ddl_rollback.py b/tests/test_t05_migration_ddl_rollback.py
new file mode 100644
--- /dev/null
+++ b/tests/test_t05_migration_ddl_rollback.py
@@ -0,0 +1,81 @@
+from contextlib import closing
+from pathlib import Path
+import sqlite3
+
+import pytest
+
+from local_ai_hub import agent_events as agent_events_module
+from local_ai_hub.agent_events import AgentEvent, AgentStateStore
+
+
+def test_migration_ddl_failure_rolls_back_after_verified_backup_and_retry(tmp_path, monkeypatch):
+    db_path = tmp_path / "agent_state.sqlite3"
+    state = AgentStateStore(db_path)
+    event = AgentEvent.create("migration-stream", "migration.sentinel", {"keep": True}, "migration-event")
+    state.append(event)
+    with closing(sqlite3.connect(db_path)) as con:
+        con.execute("DROP INDEX idx_agent_events_created")
+        con.execute("DROP INDEX idx_agent_events_kind")
+        con.execute("DROP INDEX idx_agent_snapshots_stream")
+        con.execute("PRAGMA user_version=0")
+        con.commit()
+        before_schema = con.execute(
+            "SELECT type, name, tbl_name, sql FROM sqlite_master "
+            "WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name"
+        ).fetchall()
+        before_events = con.execute(
+            "SELECT event_id, payload FROM agent_events ORDER BY stream_id, seq"
+        ).fetchall()
+
+    real_connect = sqlite3.connect
+    partial_ddl_seen = False
+    failure_injected = False
+
+    class FailingMigrationConnection(sqlite3.Connection):
+        def execute(self, sql, parameters=()):
+            nonlocal partial_ddl_seen, failure_injected
+            statement = " ".join(str(sql).split()).casefold()
+            if statement.startswith("create index if not exists idx_agent_events_created"):
+                result = super().execute(sql, parameters)
+                partial_ddl_seen = True
+                return result
+            if partial_ddl_seen and statement.startswith("create index if not exists idx_agent_snapshots_stream"):
+                failure_injected = True
+                raise sqlite3.OperationalError("injected migration DDL failure")
+            return super().execute(sql, parameters)
+
+    def connect_with_migration_fault(database, *args, **kwargs):
+        if Path(database).resolve(strict=False) == db_path.resolve():
+            kwargs["factory"] = FailingMigrationConnection
+        return real_connect(database, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(agent_events_module.sqlite3, "connect", connect_with_migration_fault)
+        with pytest.raises(sqlite3.OperationalError, match="injected migration DDL failure"):
+            AgentStateStore(db_path)._ensure_schema()
+
+    assert partial_ddl_seen is True
+    assert failure_injected is True
+    backups = sorted(tmp_path.glob("agent_state.sqlite3.migration-v0-v1-*.bak"))
+    assert len(backups) == 1
+    with closing(real_connect(db_path)) as source, closing(real_connect(backups[0])) as backup:
+        assert source.execute("PRAGMA user_version").fetchone()[0] == 0
+        assert source.execute(
+            "SELECT type, name, tbl_name, sql FROM sqlite_master "
+            "WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name"
+        ).fetchall() == before_schema
+        assert source.execute(
+            "SELECT event_id, payload FROM agent_events ORDER BY stream_id, seq"
+        ).fetchall() == before_events
+        assert backup.execute("PRAGMA quick_check").fetchone() == ("ok",)
+        assert backup.execute("PRAGMA user_version").fetchone()[0] == 0
+
+    AgentStateStore(db_path)._ensure_schema()
+    with closing(sqlite3.connect(db_path)) as con:
+        assert con.execute("PRAGMA user_version").fetchone()[0] == 1
+        assert con.execute(
+            "SELECT event_id, payload FROM agent_events ORDER BY stream_id, seq"
+        ).fetchall() == before_events
+
+
+
diff --git a/tests/test_t05_cache_rebuild_failure.py b/tests/test_t05_cache_rebuild_failure.py
new file mode 100644
--- /dev/null
+++ b/tests/test_t05_cache_rebuild_failure.py
@@ -0,0 +1,60 @@
+from contextlib import closing
+from pathlib import Path
+import sqlite3
+
+import pytest
+
+from local_ai_hub.agent_events import AgentEvent, AgentStateStore
+from local_ai_hub.agent_tasks import GoalContract, ScopeContext, TaskStore
+from local_ai_hub.cache import SQLiteCache
+
+
+def test_cache_rebuild_failure_preserves_durable_state_and_retries(tmp_path, monkeypatch):
+    state_dir = tmp_path / "state"
+    state_dir.mkdir()
+    db_path = state_dir / "agent_state.sqlite3"
+    state = AgentStateStore(db_path)
+    tasks = TaskStore(state)
+    task = tasks.create(
+        GoalContract(goal="preserve durable state", acceptance_criteria=("event",)),
+        ScopeContext(task_id="cache-rebuild-failure"),
+        task_id="cache-rebuild-failure",
+    )
+    event = AgentEvent.create(task.task_id, "cache.sentinel", {"keep": True}, "cache-event")
+    state.append(event)
+    expected_events = state.events(task.task_id)
+    durable_before = tuple(
+        path.read_bytes() if path.is_file() else None
+        for path in (db_path, Path(f"{db_path}-wal"), Path(f"{db_path}-shm"))
+    )
+    cache_path = state_dir / "cache.sqlite3"
+    cache_path.write_bytes(b"corrupt disposable cache")
+    original_create_schema = SQLiteCache._create_schema
+    attempts = 0
+
+    def fail_rebuild_after_quarantine(cache):
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            return original_create_schema(cache)
+        raise sqlite3.OperationalError("injected cache rebuild failure")
+
+    monkeypatch.setattr(SQLiteCache, "_create_schema", fail_rebuild_after_quarantine)
+    with pytest.raises(sqlite3.OperationalError, match="injected cache rebuild failure"):
+        SQLiteCache(cache_path, "t05-rebuild-failure")
+
+    assert attempts == 2
+    assert len(list(state_dir.glob("cache.sqlite3.corrupt-*"))) == 1
+    assert not list(state_dir.glob("agent_state.sqlite3.corrupt-*"))
+    assert tuple(
+        path.read_bytes() if path.is_file() else None
+        for path in (db_path, Path(f"{db_path}-wal"), Path(f"{db_path}-shm"))
+    ) == durable_before
+
+    monkeypatch.setattr(SQLiteCache, "_create_schema", original_create_schema)
+    cache = SQLiteCache(cache_path, "t05-rebuild-failure")
+    cache.set("after-retry", {"ready": True})
+    assert cache.get("after-retry") == {"ready": True}
+    reopened = AgentStateStore(db_path)
+    assert TaskStore(reopened).get(task.task_id).contract.goal == "preserve durable state"
+    assert reopened.events(task.task_id) == expected_events
