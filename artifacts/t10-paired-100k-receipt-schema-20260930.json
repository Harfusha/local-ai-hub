{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-hub.invalid/schemas/t10-paired-100k-receipt-20260930.json",
  "title": "T10 paired 100k retrieval profile receipt",
  "type": "object",
  "required": ["schema_version", "pairing", "workload", "arms", "acceptance"],
  "properties": {
    "schema_version": { "const": 1 },
    "pairing": {
      "type": "object",
      "required": ["pair_id", "method", "slot_owner", "slot_receipt", "no_competing_cpu_work", "speedup_claim"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "method": { "const": "same_host_same_harness_sequential" },
        "slot_owner": { "type": "string", "minLength": 1 },
        "slot_receipt": { "type": "string", "minLength": 1 },
        "no_competing_cpu_work": { "type": "boolean" },
        "speedup_claim": { "type": "boolean" },
        "speedup_claim_note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": ["files", "parser_backend", "cold_repeats", "warm_repeats", "graph_repeats", "lookup_repeats", "concurrency_levels", "concurrency_repeats", "max_files", "fixture_identity"],
      "properties": {
        "files": { "const": 100000 },
        "parser_backend": { "const": "auto" },
        "cold_repeats": { "const": 1 },
        "warm_repeats": { "const": 30 },
        "graph_repeats": { "const": 30 },
        "lookup_repeats": { "const": 30 },
        "concurrency_levels": { "const": [1] },
        "concurrency_repeats": { "const": 100 },
        "max_files": { "const": 100000 },
        "fixture_identity": {
          "type": "object",
          "required": ["name", "files", "path_template", "content_sha256"],
          "properties": {
            "name": { "const": "t10-synthetic-python-call-graph-v1" },
            "files": { "const": 100000 },
            "path_template": { "const": "src/module_{number:06d}.py" },
            "content_sha256": { "$ref": "#/$defs/hash" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "arms": {
      "type": "object",
      "required": ["candidate", "head_baseline"],
      "properties": {
        "candidate": {
          "allOf": [
            { "$ref": "#/$defs/arm" },
            {
              "properties": {
                "name": { "const": "current_candidate" },
                "source_pin": {
                  "required": ["candidate_worktree_patch_sha256"],
                  "properties": {
                    "git_revision": { "const": "7a36be3b8b69531dccd9215515ac793369da0a44" },
                    "package_source_tree_sha256": { "const": "cbe75a7e54743b49de7ffee932aaeeff0b939613014dbffdf57f64245fb682b6" },
                    "benchmark_inputs_sha256": { "const": "14d8f89f98588fecc426cad129c70c979c473f9b69b065d2bb18a6b4c7c3c11c" },
                    "candidate_worktree_patch_sha256": { "const": "9cc116c4a761374b98cae61577d3b41b6f9c8d194b4acd1b509ef1d445edc3fc" },
                    "fingerprint_method": { "const": "candidate_scoped_patch_plus_package_source_tree_sha256_v1" }
                  }
                },
                "coverage": {
                  "properties": {
                    "max_impact_returned": { "const": 99999 },
                    "impact_effective_limit": { "const": 100000 },
                    "impact_complete": { "const": true },
                    "impact_truncated": { "const": false }
                  }
                }
              }
            }
          ]
        },
        "head_baseline": {
          "allOf": [
            { "$ref": "#/$defs/arm" },
            {
              "properties": {
                "name": { "const": "head_baseline" },
                "source_pin": {
                  "required": ["candidate_worktree_patch_sha256"],
                  "properties": {
                    "git_revision": { "const": "7a36be3b8b69531dccd9215515ac793369da0a44" },
                    "package_source_tree_sha256": { "const": "06d72abb444acd036fb9fa42166d8a3bf07bfa0fbaca1f0cac57fb8e5d8f0d8c" },
                    "benchmark_inputs_sha256": { "const": "aa604d041afb344ceda0ab55d6b927d2f4dc54e3aae0ff0ec082d6364873be80" },
                    "candidate_worktree_patch_sha256": { "type": "null" },
                    "fingerprint_method": { "const": "committed_head_package_source_tree_sha256_v1" }
                  }
                },
                "coverage": {
                  "properties": {
                    "max_impact_returned": { "const": 100 },
                    "impact_effective_limit": { "const": 100 },
                    "impact_complete": { "const": false },
                    "impact_truncated": { "const": true }
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["both_exits_zero", "workload_equal", "source_pins_match_expected", "coverage_complete", "memory_outside_timed_loops", "all_metric_samples_present", "t02_t20_release_acceptance_separate"],
      "properties": {
        "both_exits_zero": { "type": "boolean" },
        "workload_equal": { "type": "boolean" },
        "source_pins_match_expected": { "type": "boolean" },
        "coverage_complete": { "type": "boolean", "description": "Candidate arm meets full requested coverage; legacy baseline cap is recorded per arm." },
        "memory_outside_timed_loops": { "type": "boolean" },
        "all_metric_samples_present": { "type": "boolean" },
        "t02_t20_release_acceptance_separate": { "type": "boolean" },
        "open_gaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metric": {
      "type": "object",
      "required": ["p50_ms", "p95_ms", "samples", "p95_meaningful"],
      "properties": {
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 },
        "p95_meaningful": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "repeated_metric_30": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        { "properties": { "samples": { "const": 30 }, "p95_meaningful": { "const": true } } }
      ]
    },
    "repeated_metric_100": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        { "properties": { "samples": { "const": 100 }, "p95_meaningful": { "const": true } } }
      ]
    },
    "single_sample_metric": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        { "properties": { "samples": { "const": 1 }, "p95_meaningful": { "const": false } } }
      ]
    },
    "arm": {
      "type": "object",
      "required": ["name", "command", "exit_code", "source_pin", "artifact", "environment", "coverage", "metrics", "memory"],
      "properties": {
        "name": { "enum": ["current_candidate", "head_baseline"] },
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "source_pin": {
          "type": "object",
          "required": ["git_revision", "package_source_tree_sha256", "benchmark_inputs_sha256", "fingerprint_method"],
          "properties": {
            "git_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "package_source_tree_sha256": { "$ref": "#/$defs/hash" },
            "benchmark_inputs_sha256": { "$ref": "#/$defs/hash" },
            "candidate_worktree_patch_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
            "fingerprint_method": { "type": "string", "minLength": 1 },
            "benchmark_reported_fingerprint": { "type": "string" }
          },
          "additionalProperties": true
        },
        "artifact": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/hash" }
          },
          "additionalProperties": true
        },
        "environment": {
          "type": "object",
          "required": ["timestamp_utc", "os", "python", "tree_sitter", "cpu", "memory_bytes", "concurrent_benchmark_processes"],
          "properties": {
            "timestamp_utc": { "type": "string", "format": "date-time" },
            "os": { "type": "string" },
            "python": { "type": "string" },
            "tree_sitter": { "type": ["string", "null"] },
            "cpu": { "type": "string" },
            "memory_bytes": { "type": "integer", "minimum": 1 },
            "concurrent_benchmark_processes": { "const": 0 }
          },
          "additionalProperties": true
        },
        "coverage": {
          "type": "object",
          "required": ["requested_files", "indexed_files", "expected_caller_edges", "indexed_caller_edges", "max_callers_returned", "callers_complete", "callers_truncated", "expected_impact_dependents", "max_impact_returned", "impact_effective_limit", "impact_complete", "impact_truncated", "default_impact_limit", "default_impact_truncated"],
          "properties": {
            "requested_files": { "const": 100000 },
            "indexed_files": { "const": 100000 },
            "expected_caller_edges": { "const": 100000 },
            "indexed_caller_edges": { "const": 100000 },
            "max_callers_returned": { "const": 100000 },
            "callers_complete": { "const": true },
            "callers_truncated": { "const": false },
            "expected_impact_dependents": { "const": 99999 },
            "max_impact_returned": { "type": "integer", "minimum": 0, "maximum": 99999 },
            "impact_effective_limit": { "type": "integer", "minimum": 1 },
            "impact_complete": { "type": "boolean" },
            "impact_truncated": { "type": "boolean" },
            "default_impact_limit": { "const": 50 },
            "default_impact_truncated": { "const": true }
          },
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "required": ["warm_scan", "parse_index_build", "warm_reindex", "capped_python_search", "full_coverage_python_search", "max_callers", "max_impact", "path_hint_ranking", "concurrency", "accelerator_probe"],
          "properties": {
            "warm_scan": { "$ref": "#/$defs/repeated_metric_30" },
            "parse_index_build": { "$ref": "#/$defs/single_sample_metric" },
            "warm_reindex": { "$ref": "#/$defs/repeated_metric_30" },
            "capped_python_search": { "$ref": "#/$defs/repeated_metric_30" },
            "full_coverage_python_search": { "$ref": "#/$defs/repeated_metric_30" },
            "max_callers": { "$ref": "#/$defs/repeated_metric_30" },
            "max_impact": { "$ref": "#/$defs/repeated_metric_30" },
            "path_hint_ranking": { "$ref": "#/$defs/repeated_metric_30" },
            "concurrency": {
              "type": "object",
              "required": ["max_callers", "max_impact"],
              "properties": {
                "max_callers": { "$ref": "#/$defs/repeated_metric_100" },
                "max_impact": { "$ref": "#/$defs/repeated_metric_100" }
              },
              "additionalProperties": false
            },
            "accelerator_probe": {
              "type": "object",
              "required": ["samples", "latency_ms", "ripgrep_timeouts", "ripgrep_cooldown_skips", "git_grep_timeouts", "git_grep_cooldown_skips"],
              "properties": {
                "samples": { "const": 1 },
                "latency_ms": { "type": "number", "minimum": 0 },
                "ripgrep_timeouts": { "type": "integer", "minimum": 0 },
                "ripgrep_cooldown_skips": { "type": "integer", "minimum": 0 },
                "git_grep_timeouts": { "type": "integer", "minimum": 0 },
                "git_grep_cooldown_skips": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "memory": {
          "type": "object",
          "required": ["scope", "peak_working_set_bytes", "peak_increase_during_case_bytes", "measured_outside_timed_loops"],
          "properties": {
            "scope": { "const": "process_lifetime_high_water_mark" },
            "peak_working_set_bytes": { "type": "integer", "minimum": 1 },
            "peak_increase_during_case_bytes": { "type": "integer", "minimum": 0 },
            "measured_outside_timed_loops": { "const": true }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pairing": {
            "properties": { "speedup_claim": { "const": true } },
            "required": ["speedup_claim"]
          }
        },
        "required": ["pairing"]
      },
      "then": {
        "properties": {
          "pairing": {
            "properties": { "no_competing_cpu_work": { "const": true } }
          },
          "acceptance": {
            "properties": {
              "both_exits_zero": { "const": true },
              "workload_equal": { "const": true },
              "source_pins_match_expected": { "const": true },
              "coverage_complete": { "const": true },
              "memory_outside_timed_loops": { "const": true },
              "all_metric_samples_present": { "const": true },
              "t02_t20_release_acceptance_separate": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
