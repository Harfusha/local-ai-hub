+def test_global_memory_delete_ignores_transport_tenant_but_keeps_scope(store: MemoryStore, tmp_path: Path):
+    repo = tmp_path / "repo-a"
+    other_repo = tmp_path / "repo-b"
+    repo.mkdir()
+    other_repo.mkdir()
+    global_record = store.record(MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.GLOBAL,
+        key="global-delete-tenant",
+        value="global value",
+        provenance={"root": str(repo), "repository_id": "repo-a", "tenant": "legacy-tenant"},
+    ), actor="user")
+
+    request_record = store.get(
+        global_record.record_id,
+        scope=AgentScope.GLOBAL,
+        root=str(repo),
+        repository_id="repo-a",
+        tenant="codex",
+    )
+    assert request_record == global_record
+    assert store.get(
+        global_record.record_id,
+        scope=AgentScope.GLOBAL,
+        root=str(other_repo),
+        repository_id="repo-a",
+        tenant="codex",
+    ) is None
+    assert store.delete(
+        global_record.record_id,
+        scope=request_record.scope,
+        scope_id=request_record.scope_id,
+        tenant="codex",
+    ) is True
+
+    session_record = store.record(MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.SESSION,
+        scope_id="session-codex",
+        key="tenant-delete-guard",
+        value="tenant value",
+        provenance={"tenant": "codex"},
+    ), actor="user")
+    assert store.get(
+        session_record.record_id,
+        scope=AgentScope.SESSION,
+        scope_id="session-codex",
+        tenant="other-tenant",
+    ) is None
+    assert store.get(
+        session_record.record_id,
+        scope=AgentScope.SESSION,
+        scope_id="session-codex",
+        tenant="codex",
+    ) == session_record
+
+
+def test_scoped_memory_delete_requires_matching_tenant(store: MemoryStore):
+    record = store.record(MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.SESSION,
+        scope_id="session-owner",
+        key="tenant-delete-identity",
+        value="tenant private value",
+        provenance={"tenant": "owner-tenant"},
+    ), actor="user")
+
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+    ) is False
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="other-tenant",
+    ) is False
+    assert store.get(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) == record
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) is True
+    assert store.get(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) is None
+
