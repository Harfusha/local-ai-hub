+def test_inference_counter_cleans_up_for_exception_and_rejection(tmp_path: Path):
+    manager = build_manager(tmp_path)
+    try:
+        assert manager.active_inference_operations == 0
+        for failure in (RuntimeError("operation failed"), asyncio.CancelledError()):
+            with pytest.raises(type(failure)):
+                with manager.inference_operation(lambda: True) as admitted:
+                    assert admitted
+                    assert manager.active_inference_operations == 1
+                    raise failure
+            assert manager.active_inference_operations == 0
+        with manager.inference_operation(lambda: False) as admitted:
+            assert not admitted
+            assert manager.active_inference_operations == 0
+    finally:
+        manager.close()
+
