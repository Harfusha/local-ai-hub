+def test_mode_guard_timeout_fails_closed_and_releases_admission_lock(tmp_path: Path):
+    manager = build_manager(tmp_path)
+    release_operation = threading.Event()
+    operation_started = threading.Event()
+
+    def active_operation() -> None:
+        with manager.inference_operation():
+            operation_started.set()
+            assert release_operation.wait(3)
+
+    thread = threading.Thread(target=active_operation)
+    try:
+        thread.start()
+        assert operation_started.wait(2)
+        with pytest.raises(TimeoutError, match="did not drain"):
+            with manager.operational_mode_change_guard(timeout_seconds=0.01):
+                pytest.fail("mode transition entered while inference was active")
+        assert manager.active_inference_operations == 1
+        assert not manager._inference_transition_active
+        release_operation.set()
+        thread.join(timeout=2)
+        with manager.operational_mode_change_guard(timeout_seconds=1):
+            assert manager.active_inference_operations == 0
+    finally:
+        release_operation.set()
+        thread.join(timeout=4)
+        manager.close()
+
+
+def test_mode_guard_drains_active_work_and_blocks_new_inference(tmp_path: Path):
+    manager = build_manager(tmp_path)
+    operation_started = threading.Event()
+    release_operation = threading.Event()
+    transition_entered = threading.Event()
+    release_transition = threading.Event()
+    new_operation_entered = threading.Event()
+    new_admission: list[bool] = []
+
+    def active_operation() -> None:
+        with manager.inference_operation() as admitted:
+            assert admitted
+            operation_started.set()
+            assert release_operation.wait(3)
+
+    def transition() -> None:
+        with manager.operational_mode_change_guard(timeout_seconds=3):
+            transition_entered.set()
+            assert release_transition.wait(3)
+
+    def after_transition() -> None:
+        with manager.inference_operation(lambda: False) as admitted:
+            new_admission.append(admitted)
+            new_operation_entered.set()
+
+    operation_thread = threading.Thread(target=active_operation)
+    transition_thread = threading.Thread(target=transition)
+    new_thread = threading.Thread(target=after_transition)
+    try:
+        operation_thread.start()
+        assert operation_started.wait(2)
+        transition_thread.start()
+        deadline = time.monotonic() + 2
+        while time.monotonic() < deadline:
+            with manager._inference_condition:
+                if manager._inference_transition_active:
+                    break
+            time.sleep(0.005)
+        assert manager._inference_transition_active
+        new_thread.start()
+        assert not transition_entered.wait(0.05)
+        assert not new_operation_entered.wait(0.05)
+        release_operation.set()
+        assert transition_entered.wait(2)
+        assert manager.active_inference_operations == 0
+        assert not new_operation_entered.wait(0.05)
+        release_transition.set()
+        assert new_operation_entered.wait(2)
+        assert new_admission == [False]
+        assert manager.active_inference_operations == 0
+    finally:
+        release_operation.set()
+        release_transition.set()
+        for thread in (operation_thread, transition_thread, new_thread):
+            if thread.ident is not None:
+                thread.join(timeout=4)
+        manager.close()
+    assert all(not thread.is_alive() for thread in (operation_thread, transition_thread, new_thread))
+
+
+def test_blocked_admission_keeps_durable_job_queued_without_duplicate_rows(tmp_path: Path):
+    executions: list[str] = []
+    manager = build_manager(tmp_path, lambda action, _payload, _tenant: executions.append(action) or {"success": True})
+    try:
+        submitted = manager.submit(
+            "tenant-a", "delegate", {"request_id": "queued-inference"},
+            dispatch_delay_seconds=30,
+        )
+        assert submitted["state"] == "queued"
+        timer = manager._delayed_dispatch.pop(submitted["job_id"], None)
+        if timer is not None:
+            timer.cancel()
+
+        with manager.operational_mode_change_guard(timeout_seconds=1):
+            with manager.inference_operation(lambda: False) as admitted:
+                assert not admitted
+        with closing(manager._connect()) as con:
+            rows = con.execute(
+                "SELECT state FROM async_jobs WHERE job_id = ?",
+                (submitted["job_id"],),
+            ).fetchall()
+        assert [row[0] for row in rows] == ["queued"]
+        assert executions == []
+    finally:
+        manager.close()
