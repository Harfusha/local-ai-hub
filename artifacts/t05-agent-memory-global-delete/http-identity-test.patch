--- /dev/null
+++ b/tests/test_agent_memory_http_identity.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+import json
+import threading
+import urllib.error
+import urllib.request
+
+from local_ai_hub import http_server
+from local_ai_hub.agent_identity import AgentScope
+from local_ai_hub.agent_memory import MemoryKind, MemoryRecord
+from local_ai_hub.app import LocalAIApp
+
+
+def test_http_global_memory_identity_ignores_transport_tenant_but_keeps_scope(tmp_path):
+    state_dir = tmp_path / "state"
+    repo_a = tmp_path / "repo-a"
+    repo_b = tmp_path / "repo-b"
+    state_dir.mkdir()
+    repo_a.mkdir()
+    repo_b.mkdir()
+    config_path = tmp_path / "config.toml"
+    config_path.write_text(
+        f'[server]\nbind = "127.0.0.1"\nport = 39131\nstate_dir = "{state_dir.as_posix()}"\n\n'
+        "[agent_state]\nenabled = true\n",
+        encoding="utf-8",
+    )
+    app = LocalAIApp(str(config_path))
+    global_record = MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.GLOBAL,
+        key="global-http-tenant",
+        value="shared global value",
+        provenance={"root": str(repo_a), "repository_id": "repo-a", "tenant": "legacy-tenant"},
+    )
+    app.agent_memory.record(global_record, actor="user")
+    session_record = MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.SESSION,
+        scope_id="session-codex",
+        key="session-http-tenant",
+        value="private session value",
+        provenance={"tenant": "codex"},
+    )
+    app.agent_memory.record(session_record, actor="user")
+
+    previous_app = http_server.APP
+    http_server.APP = app
+    server = http_server.LocalAIHTTPServer(("127.0.0.1", 0), http_server.Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+
+    def post(payload):
+        request = urllib.request.Request(
+            f"http://127.0.0.1:{server.server_address[1]}/api/agent-state/memory",
+            data=json.dumps(payload).encode("utf-8"),
+            headers={
+                "Content-Type": "application/json",
+                "X-LocalAI-Tenant": "codex",
+                "Connection": "close",
+            },
+            method="POST",
+        )
+        try:
+            with urllib.request.urlopen(request) as response:
+                return response.status, json.loads(response.read().decode("utf-8"))
+        except urllib.error.HTTPError as exc:
+            return exc.code, json.loads(exc.read().decode("utf-8"))
+
+    try:
+        global_payload = {
+            "action": "get",
+            "record_id": global_record.record_id,
+            "scope": "global",
+            "root": str(repo_a),
+            "repository_id": "repo-a",
+            "tenant": "codex",
+        }
+        status, found = post(global_payload)
+        assert status == 200
+        assert found["record"]["record_id"] == global_record.record_id
+
+        wrong_root = {**global_payload, "root": str(repo_b)}
+        status, denied_root = post(wrong_root)
+        assert status == 404
+        assert denied_root["success"] is False
+
+        session_payload = {
+            "action": "get",
+            "record_id": session_record.record_id,
+            "scope": "session",
+            "scope_id": "session-codex",
+            "tenant": "other-tenant",
+        }
+        status, denied_tenant = post(session_payload)
+        assert status == 404
+        assert denied_tenant["success"] is False
+
+        status, found_session = post({**session_payload, "tenant": "codex"})
+        assert status == 200
+        assert found_session["record"]["record_id"] == session_record.record_id
+
+        delete_payload = {
+            "action": "delete",
+            "record_id": global_record.record_id,
+            "scope": "global",
+            "root": str(repo_a),
+            "repository_id": "repo-a",
+            "tenant": "codex",
+        }
+        status, denied_delete = post({**delete_payload, "root": str(repo_b)})
+        assert status == 404
+        assert denied_delete["success"] is False
+        assert app.agent_memory.get(global_record.record_id) is not None
+
+        status, deleted = post(delete_payload)
+        assert status == 200
+        assert deleted["deleted"] is True
+        assert app.agent_memory.get(global_record.record_id) is None
+    finally:
+        server.shutdown()
+        thread.join(timeout=5)
+        server.server_close()
+        http_server.APP = previous_app
+        app.close()
