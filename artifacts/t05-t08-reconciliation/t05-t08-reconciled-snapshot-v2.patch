+def _sqlite_file_snapshot(db_path):
+    paths = (
+        db_path,
+        Path(f"{db_path}-wal"),
+        Path(f"{db_path}-shm"),
+        Path(f"{db_path}-journal"),
+    )
+    return tuple(path.read_bytes() if path.is_file() else None for path in paths)
