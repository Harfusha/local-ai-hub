+def test_scoped_memory_delete_requires_matching_tenant(store: MemoryStore):
+    record = store.record(MemoryRecord.create(
+        kind=MemoryKind.FACT,
+        scope=AgentScope.SESSION,
+        scope_id="session-owner",
+        key="tenant-delete-identity",
+        value="tenant private value",
+        provenance={"tenant": "owner-tenant"},
+    ), actor="user")
+
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+    ) is False
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="other-tenant",
+    ) is False
+    assert store.get(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) == record
+    assert store.delete(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) is True
+    assert store.get(
+        record.record_id,
+        scope=record.scope,
+        scope_id=record.scope_id,
+        tenant="owner-tenant",
+    ) is None
