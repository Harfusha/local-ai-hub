--- /dev/null
+++ b/tests/test_agent_memory_t08_rollback_masking.py
@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+
+import pytest
+
+from local_ai_hub.agent_events import AgentStateStore
+from local_ai_hub.agent_identity import AgentScope
+from local_ai_hub.agent_memory import MemoryKind, MemoryRecord, MemoryStore
+from local_ai_hub.sqlite_support import connect_sqlite
+
+
+def test_delete_preserves_primary_fts_error_when_rollback_also_fails(tmp_path, monkeypatch):
+    root = tmp_path / "repo"
+    root.mkdir()
+    db_path = tmp_path / "agent_state.sqlite3"
+    store = MemoryStore(AgentStateStore(db_path))
+    record = store.record(
+        MemoryRecord.create(
+            kind=MemoryKind.FACT,
+            scope=AgentScope.REPOSITORY,
+            scope_id=str(root),
+            key="rollback-error-priority",
+            value="keep original exception",
+            source="user",
+            provenance={"root": str(root), "tenant": "tenant-a"},
+        ),
+        actor="user",
+    )
+    with closing(connect_sqlite(db_path)) as con:
+        fts_exists = con.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='agent_memory_fts'"
+        ).fetchone() is not None
+    if not fts_exists:
+        pytest.skip("FTS5 unavailable")
+
+    real_connect = sqlite3.connect
+
+    class FtsAndRollbackFailingConnection(sqlite3.Connection):
+        def execute(self, sql, parameters=()):
+            normalized = " ".join(str(sql).split()).casefold()
+            if normalized.startswith("delete from agent_memory_fts"):
+                raise sqlite3.OperationalError("injected primary FTS delete failure")
+            if normalized == "rollback":
+                raise sqlite3.OperationalError("injected secondary rollback failure")
+            return super().execute(sql, parameters)
+
+    def connect_with_faults(database, *args, **kwargs):
+        if Path(database).resolve(strict=False) == db_path.resolve():
+            kwargs["factory"] = FtsAndRollbackFailingConnection
+        return real_connect(database, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(sqlite3, "connect", connect_with_faults)
+        with pytest.raises(
+            sqlite3.OperationalError,
+            match="injected primary FTS delete failure",
+        ):
+            store.delete(
+                record.record_id,
+                scope=AgentScope.REPOSITORY,
+                scope_id=str(root),
+                root=str(root),
+                tenant="tenant-a",
+            )
