+        repo_root=root,
+        tenant="tenant-a",
+        task_id="match-2",
+    )
+
+    rows = [json.loads(line) for line in output.read_text(encoding="utf-8").splitlines()]
+    assert result["count"] == 1
+    assert [row["task_id"] for row in rows] == ["match-2"]
