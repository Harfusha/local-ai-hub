+    def _save_record_mutation(self, record: MemoryRecord, event: AgentEvent) -> MemoryRecord:
+        """Commit a memory projection mutation and event as one durable write."""
+        if not self.state_store.enabled:
+            self._save_record(record)
+            return record
+        self._init_table()
+
+        def _do_mutation() -> MemoryRecord:
+            con = connect_sqlite(self.state_store.db_path, isolation_level=None)
+            try:
+                # Enter publication before BEGIN. The caller-owned transaction
+                # commits the projection and outbox together; publish afterward.
+                with self.state_store.ordered_event_publication(con) as publish:
+                    con.execute("BEGIN IMMEDIATE")
+                    appended = self.state_store.append_in_transaction(
+                        con,
+                        event,
+                        strict_idempotency=False,
+                    )
+                    self._save_record_row(con, record)
+                    con.execute("COMMIT")
+                    publish([appended.event])
+                return record
+            except Exception:
+                if con.in_transaction:
+                    con.execute("ROLLBACK")
+                raise
+            finally:
+                con.close()
+
+        return retry_busy(_do_mutation, retries=5, base_delay_seconds=0.02)
