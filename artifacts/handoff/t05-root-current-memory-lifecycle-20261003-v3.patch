+            },
+            tenant="tenant-b",
+        )
+        assert status == 200
+        assert tenant_list["records"] == []
+
+        status, spoofed_query_tenant = request(
+            "GET",
+            params={
+                "scope": "global",
+                "root": str(repo_a),
+                "key": tenant_owned.key,
+                "tenant": "tenant-b",
+            },
