+        assert app.agent_memory.get(
+            global_record.record_id,
+            scope=AgentScope.GLOBAL,
+            root=str(repo_a.resolve()),
+            repository_id="repo-a",
+            tenant="codex",
+            tenant_agnostic_global=True,
+        ) is None
+    finally:
+        server.shutdown()
+        thread.join(timeout=5)
+        server.server_close()
+        http_server.APP = previous_app
+        app.close()
