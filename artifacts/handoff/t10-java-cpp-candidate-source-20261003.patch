+            if name and re.fullmatch(r"[A-Za-z_$][\w$]*", name):
+                refs.append({"name": name, "line": node.start_point.row + 1, "kind": "call"})
+                edges.append({
+                    "src": current_function or "<module>",
+                    "dst": name,
+                    "kind": "calls",
+                    "line": node.start_point.row + 1,
+                })
+
+        for child in node.children:
