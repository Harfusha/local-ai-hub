diff --git a/tests/test_t08_async_admission_lifecycle.py b/tests/test_t08_async_admission_lifecycle.py
--- a/tests/test_t08_async_admission_lifecycle.py
+++ b/tests/test_t08_async_admission_lifecycle.py
@@ -116,3 +116,34 @@
     finally:
         release.set()
         manager.close()
+
+
+def test_nested_admissions_track_distinct_actions_and_drain_selectively(tmp_path: Path, monkeypatch):
+    manager = _manager(tmp_path)
+    _allow_active_mode(manager, monkeypatch)
+    drained: list[str] = []
+    try:
+        with manager.inference_admission("delegate") as outer_rejection:
+            assert outer_rejection is None
+            assert len(manager._inference_admissions) == 1
+
+            with manager.inference_admission("delegate") as same_action_rejection:
+                assert same_action_rejection is None
+                assert len(manager._inference_admissions) == 1
+
+            with manager.inference_admission("vision") as nested_rejection:
+                assert nested_rejection is None
+                assert len(manager._inference_admissions) == 2
+                assert not manager.wait_for_inference_actions({"vision"}, 0)
+                assert manager.inference_actions_active(exclude_actions={"delegate"})
+                manager.when_inference_actions_drained(
+                    {"vision"}, lambda: drained.append("vision")
+                )
+                assert drained == []
+
+            assert manager.wait_for_inference_actions({"vision"}, 0.1)
+            assert drained == ["vision"]
+            assert not manager.inference_actions_active(exclude_actions={"delegate"})
+            assert manager.inference_actions_active()
+    finally:
+        manager.close()
