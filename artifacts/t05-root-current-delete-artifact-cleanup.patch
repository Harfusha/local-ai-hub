--- /dev/null
+++ b/tests/test_t05_memory_delete_artifacts.py
@@ -0,0 +1,144 @@
+from contextlib import closing
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from local_ai_hub import agent_memory as agent_memory_module
+from local_ai_hub.agent_events import AgentStateStore
+from local_ai_hub.agent_identity import AgentScope
+from local_ai_hub.agent_memory import MemoryKind, MemoryRecord, MemoryStore
+from local_ai_hub.sqlite_support import connect_sqlite
+
+
+def test_scoped_delete_purges_fts_and_embedding_artifacts(tmp_path):
+    root = tmp_path / "repo"
+    root.mkdir()
+    store = MemoryStore(AgentStateStore(tmp_path / "agent_state.sqlite3"))
+    record = store.record(
+        MemoryRecord.create(
+            kind=MemoryKind.FACT,
+            scope=AgentScope.REPOSITORY,
+            scope_id=str(root),
+            key="delete-search-artifacts",
+            value="sensitive searchable memory",
+            source="user",
+            provenance={"root": str(root), "tenant": "tenant-a"},
+        ),
+        actor="user",
+        idempotency_key="delete-search-artifacts",
+    )
+    assert store.set_embedding(record.record_id, [0.25, 0.75])
+    with closing(connect_sqlite(store.state_store.db_path)) as con:
+        fts_exists = con.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='agent_memory_fts'"
+        ).fetchone() is not None
+        assert con.execute(
+            "SELECT COUNT(*) FROM agent_memory_embeddings WHERE record_id = ?",
+            (record.record_id,),
+        ).fetchone()[0] == 1
+        if fts_exists:
+            assert con.execute(
+                "SELECT COUNT(*) FROM agent_memory_fts WHERE record_id = ?",
+                (record.record_id,),
+            ).fetchone()[0] == 1
+
+    assert store.delete(
+        record.record_id,
+        scope=AgentScope.REPOSITORY,
+        scope_id=str(root),
+        root=str(root),
+        tenant="tenant-a",
+    )
+    with closing(connect_sqlite(store.state_store.db_path)) as con:
+        assert con.execute(
+            "SELECT COUNT(*) FROM agent_memory_embeddings WHERE record_id = ?",
+            (record.record_id,),
+        ).fetchone()[0] == 0
+        if fts_exists:
+            assert con.execute(
+                "SELECT COUNT(*) FROM agent_memory_fts WHERE record_id = ?",
+                (record.record_id,),
+            ).fetchone()[0] == 0
+
+
+def test_delete_fts_failure_rolls_back_record_and_embeddings(tmp_path, monkeypatch):
+    root = tmp_path / "repo"
+    root.mkdir()
+    db_path = tmp_path / "agent_state.sqlite3"
+    store = MemoryStore(AgentStateStore(db_path))
+    record = store.record(
+        MemoryRecord.create(
+            kind=MemoryKind.FACT,
+            scope=AgentScope.REPOSITORY,
+            scope_id=str(root),
+            key="rollback-delete-primary",
+            value="retain after failed deletion",
+            source="user",
+            provenance={"root": str(root), "tenant": "tenant-a"},
+        ),
+        actor="user",
+    )
+    related = store.record(
+        MemoryRecord.create(
+            kind=MemoryKind.FACT,
+            scope=AgentScope.REPOSITORY,
+            scope_id=str(root),
+            key="rollback-delete-related",
+            value="retain relation",
+            source="user",
+            provenance={"root": str(root), "tenant": "tenant-a"},
+        ),
+        actor="user",
+    )
+    store.record_relation(record.record_id, "related_to", related.record_id)
+    assert store.set_embedding(record.record_id, [0.5, 0.5])
+    with closing(connect_sqlite(db_path)) as con:
+        fts_exists = con.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='agent_memory_fts'"
+        ).fetchone() is not None
+    if not fts_exists:
+        pytest.skip("FTS5 unavailable")
+    stream_id = "memory:" + "".join(
+        f"{len(part)}:{part}" for part in (record.scope.value, record.scope_id or "", record.key or record.record_id)
+    )
+    events_before = store.state_store.events(stream_id)
+
+    real_connect = sqlite3.connect
+
+    class FailingFtsConnection(sqlite3.Connection):
+        def execute(self, sql, parameters=()):
+            if " ".join(str(sql).split()).casefold().startswith("delete from agent_memory_fts"):
+                raise sqlite3.OperationalError("injected FTS delete failure")
+            return super().execute(sql, parameters)
+
+    def connect_with_fts_failure(database, *args, **kwargs):
+        if Path(database).resolve(strict=False) == db_path.resolve():
+            kwargs["factory"] = FailingFtsConnection
+        return real_connect(database, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(agent_memory_module.sqlite3, "connect", connect_with_fts_failure)
+        with pytest.raises(sqlite3.OperationalError, match="injected FTS delete failure"):
+            store.delete(
+                record.record_id,
+                scope=AgentScope.REPOSITORY,
+                scope_id=str(root),
+                root=str(root),
+                tenant="tenant-a",
+            )
+
+    assert store.state_store.events(stream_id) == events_before
+    assert store.get(
+        record.record_id,
+        scope=AgentScope.REPOSITORY,
+        scope_id=str(root),
+        root=str(root),
+        tenant="tenant-a",
+    ) == record
+    assert store.find_relations(source_entity=record.record_id)
+    with closing(connect_sqlite(db_path)) as con:
+        assert con.execute(
+            "SELECT COUNT(*) FROM agent_memory_embeddings WHERE record_id = ?",
+            (record.record_id,),
+        ).fetchone()[0] == 1
+        assert con.execute(
+            "SELECT COUNT(*) FROM agent_memory_fts WHERE record_id = ?",
+            (record.record_id,),
+        ).fetchone()[0] == 1
+
