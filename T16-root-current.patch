+            "response_profile": "debug",
+        })
+        assert services.validation_started.wait(timeout=5)
+        cancellation = wo.cancel("tenant", submitted["work_id"])
+        services.release_validation.set()
+        result = wait_terminal(wo, submitted["work_id"])
