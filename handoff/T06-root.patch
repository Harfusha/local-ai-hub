+        def close(self) -> None:
+            pass
+
+    class LiveProcess:
+        pid = 24680
+        returncode = None
+
+        def __init__(self) -> None:
+            self.stdout = Stream()
+            self.stderr = Stream()
+            self.kill_calls = 0
+            self.wait_calls = 0
+
+        def poll(self) -> None:
+            return None
+
+        def kill(self) -> None:
+            self.kill_calls += 1
+
+        def wait(self, *_args, **_kwargs):
+            self.wait_calls += 1
+            raise AssertionError("unconfirmed process must not be waited/reaped")
+
+    process = LiveProcess()
+    cleanup_calls: list[tuple[int, float]] = []
+    monkeypatch.setattr(commands_module.subprocess, "Popen", lambda *_args, **_kwargs: process)
+    monkeypatch.setattr(
+        commands_module,
+        "terminate_tree",
+        lambda pid, *, grace_seconds: cleanup_calls.append((pid, grace_seconds)) or False,
+    )
+    ticks = iter((0.0, 2.0))
+    monkeypatch.setattr(
+        commands_module,
+        "time",
+        SimpleNamespace(perf_counter=lambda: 0.0, monotonic=lambda: next(ticks), sleep=lambda _s: None),
