+def test_private_snapshot_does_not_retain_source_remote(tmp_path: Path) -> None:
+    source = tmp_path / "source"
+    _make_source_repo(source)
+
+    snapshot = create_private_transaction_snapshot(source, tmp_path / "transaction")
