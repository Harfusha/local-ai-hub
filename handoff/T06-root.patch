+    tracked.write_text("committed\n", encoding="utf-8")
+    git("add", tracked.name)
+    git("commit", "-m", "initial")
+    tracked.write_text("dirty\n", encoding="utf-8")
+    (tmp_path / "untracked.txt").write_text("untracked\n", encoding="utf-8")
+
+    sentinel = tmp_path / "stash-message-injection.txt"
+    if os.name == "nt":
+        message = f'plain"; Set-Content -NoNewline -LiteralPath \'{sentinel}\' -Value injected; #'
+    else:
+        message = f'plain"; touch \'{sentinel}\'; #'
+
+    broker = CommandBroker({"server": {"state_dir": str(tmp_path)}})
+    broker.set_task_store(_FakeTaskStore(str(tmp_path)))
