diff --git a/tests/test_frontend_coder_context.py b/tests/test_frontend_coder_context.py
--- a/tests/test_frontend_coder_context.py
+++ b/tests/test_frontend_coder_context.py
@@ -102,0 +103,16 @@
+
+
+def test_coder_context_preserves_numeric_zero_dom_id() -> None:
+    packet = build_coder_context(
+        {"summary": "Button needs attention", "findings": [{"finding_id": "f-1", "element_ids": ["0"]}]},
+        {
+            "prompt": "Review button",
+            "dom": {
+                "redaction": "none",
+                "elements": [{"element_id": 0, "tag": "button"}],
+            },
+        },
+    )
+
+    assert packet["success"] is True
+    assert packet["dom"]["elements"] == [{"element_id": 0, "tag": "button"}]
