+from __future__ import annotations
+
+import subprocess
+from contextlib import closing
+from pathlib import Path
+
+import pytest
+
+from local_ai_hub.rag import RAGStore
+
+
+class RecordingEmbedder:
+    def embed(self, texts, _tenant, **_kwargs):
+        return {
+            "success": True,
+            "embeddings": [[1.0, float(index + 1)] for index in range(len(texts))],
+            "backend": "test",
+            "embedding_space_id": "t11-linked-worktree-policy",
+        }
+
+
+def _git(root: Path, *args: str) -> str:
+    completed = subprocess.run(
+        ["git", *args], cwd=root, check=True, capture_output=True, text=True
+    )
+    return completed.stdout.strip()
+
+
+def _stored_paths(store: RAGStore, tenant: str, workspace: str) -> set[str]:
+    with closing(store._connect()) as con:
+        rows = con.execute(
+            "SELECT path FROM files WHERE tenant=? AND workspace=?",
+            (store._scope_key(tenant), workspace),
+        ).fetchall()
+    return {str(row[0]) for row in rows}
+
+
+@pytest.mark.parametrize("entrypoint", ["index", "index_step", "index_paths_step"])
+def test_linked_worktree_phase_override_is_resolved_by_rag_consumers(
+    tmp_path: Path, entrypoint: str,
+) -> None:
+    primary = tmp_path / "primary"
+    linked = tmp_path / "linked"
+    primary.mkdir()
+    _git(primary, "init", "--quiet")
+    _git(primary, "config", "user.email", "test@example.invalid")
+    _git(primary, "config", "user.name", "Test")
+    (primary / ".local-ai.toml").write_text(
+        'shared_namespace = "primary"\n', encoding="utf-8"
+    )
+    (primary / "module.py").write_text("value = 1\n", encoding="utf-8")
+    _git(primary, "add", ".local-ai.toml", "module.py")
+    _git(primary, "commit", "--quiet", "-m", "fixture")
+    _git(primary, "worktree", "add", "--quiet", "--detach", str(linked), "HEAD")
+    (linked / ".local-ai.worktree.toml").write_text(
+        'shared_namespace = "linked"\nskip_phases = ["rag"]\n',
+        encoding="utf-8",
+    )
+    config = {
+        "server": {"state_dir": str(tmp_path / "state")},
+        "rag": {"extensions": [".py"], "ignore_dirs": [], "max_file_bytes": 1024},
+    }
+    store = RAGStore(config, services=RecordingEmbedder())
+    workspace = store.workspace_id(str(linked))
+
+    if entrypoint == "index":
+        result = store.index(str(linked), "tenant", workspace)
+    elif entrypoint == "index_step":
+        result = store.index_step(str(linked), "tenant", workspace, max_files=10)
+    else:
+        result = store.index_paths_step(str(linked), "tenant", workspace, ["module.py"])
+
+    assert result["success"] is True
+    assert result.get("skipped") is True
+    assert _stored_paths(store, "tenant", workspace) == set()
