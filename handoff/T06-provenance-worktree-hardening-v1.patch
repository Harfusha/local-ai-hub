diff --git a/tests/test_t06_server_command_provenance.py b/tests/test_t06_server_command_provenance.py
new file mode 100644
--- /dev/null
+++ b/tests/test_t06_server_command_provenance.py
@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from local_ai_hub.commands import CommandBroker
+
+
+class _Artifacts:
+    def __init__(self) -> None:
+        self.records: list[tuple[dict[str, Any], str, str]] = []
+
+    def put_json(self, value: dict[str, Any], owner: str, kind: str) -> str:
+        self.records.append((value, owner, kind))
+        return "artifact-server-stub"
+
+
+class _VerificationStore:
+    def __init__(self) -> None:
+        self.receipts: list[Any] = []
+
+    def record(self, receipt: Any) -> Any:
+        self.receipts.append(receipt)
+        return receipt
+
+
+def test_cached_success_does_not_mint_command_verification_receipt(tmp_path: Path) -> None:
+    artifacts = _Artifacts()
+    verification = _VerificationStore()
+    broker = CommandBroker({"server": {"state_dir": str(tmp_path / "state")}}, artifacts=artifacts)
+    broker.set_verification_store(verification)
+
+    broker._record_command_verification(
+        {"success": True, "exit_code": 0},
+        tenant="tenant-a",
+        task_id="task-a",
+        criterion="pytest",
+        command="pytest -q",
+        command_id="cache_fabricated-id",
+        command_digest="a" * 64,
+        repository_revision="revision-1",
+        duration_ms=2.0,
+        project_alias="pytest",
+        project_config_digest="config-digest",
+        project_environment_sha256="environment-digest",
+        cached=True,
+    )
+
+    assert artifacts.records == []
+    assert verification.receipts == []
+
+
+def test_command_verification_records_server_run_by_command_id(tmp_path: Path) -> None:
+    artifacts = _Artifacts()
+    verification = _VerificationStore()
+    broker = CommandBroker({"server": {"state_dir": str(tmp_path / "state")}}, artifacts=artifacts)
+    broker.set_verification_store(verification)
+    command_id = "execution-server-generated"
+
+    broker._record_command_verification(
+        {"success": True, "exit_code": 0},
+        tenant="tenant-a",
+        task_id="task-a",
+        criterion="pytest",
+        command="pytest -q",
+        command_id=command_id,
+        command_digest="b" * 64,
+        repository_revision="revision-2",
+        duration_ms=3.0,
+        project_alias="pytest",
+        project_config_digest="config-digest",
+        project_environment_sha256="environment-digest",
+        cached=False,
+    )
+
+    record = broker._get_server_command_execution_record(command_id)
+    assert record is not None
+    assert record["command_id"] == command_id
+    assert record["task_id"] == "task-a"
+    assert record["tenant_identity"] == broker._tenant_identity("tenant-a")
+    assert record["command_sha256"] == "b" * 64
+    assert record["evidence_id"] == "artifact-server-stub"
+    assert "issuer" not in record
+    record["task_id"] = "forged-task"
+    assert broker._get_server_command_execution_record(command_id)["task_id"] == "task-a"
diff --git a/tests/test_t06_worktree_subprocess_tracking.py b/tests/test_t06_worktree_subprocess_tracking.py
new file mode 100644
--- /dev/null
+++ b/tests/test_t06_worktree_subprocess_tracking.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import subprocess
+import uuid
+from pathlib import Path
+
+import pytest
+
+from local_ai_hub import process_utils
+
+
+def _git(repo: Path, *args: str) -> None:
+    subprocess.run(
+        ["git", "-C", str(repo), *args],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_git_worktree_lifecycle_uses_tracked_subprocess_runner(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    _git(repo, "config", "user.name", "T06 test")
+    _git(repo, "config", "user.email", "t06@example.invalid")
+    (repo / "tracked.txt").write_text("seed\n", encoding="utf-8")
+    _git(repo, "add", "tracked.txt")
+    _git(repo, "commit", "-qm", "seed")
+
+    tracked: list[tuple[str, ...]] = []
+    original_run_hidden = process_utils.run_hidden
+    original_subprocess_run = subprocess.run
+
+    def observe_run_hidden(argv, **kwargs):
+        tracked.append(tuple(str(part) for part in argv))
+        return original_run_hidden(argv, **kwargs)
+
+    def reject_untracked_subprocess(*_args, **_kwargs):
+        raise AssertionError("worktree helper bypassed tracked process runner")
+
+    monkeypatch.setattr(process_utils, "run_hidden", observe_run_hidden)
+    monkeypatch.setattr(process_utils.subprocess, "run", reject_untracked_subprocess)
+
+    branch = f"t06-route-{uuid.uuid4().hex[:8]}"
+    target = tmp_path / "isolated-worktree"
+    created = process_utils.create_git_worktree(
+        repo,
+        branch_name=branch,
+        worktree_path=target,
+        base_commit="HEAD",
+        task_id="task-t06",
+        owner="t06-test",
+    )
+    assert created["success"] is True, created
+
+    removed = process_utils.remove_git_worktree(
+        repo,
+        target,
+        worktree_id=created["worktree_id"],
+        branch_name=branch,
+    )
+    assert removed["success"] is True, removed
+    pruned = process_utils.prune_git_worktrees(repo)
+    assert pruned["success"] is True, pruned
+    assert any("worktree" in call and "add" in call for call in tracked)
+    assert any("status" in call for call in tracked)
+    assert any("worktree" in call and "remove" in call for call in tracked)
+    assert any("worktree" in call and "prune" in call for call in tracked)
+    assert any("worktree" in call and "prune" in call and "-v" in call for call in tracked)
+    assert any("branch" in call and "-d" in call for call in tracked)
+    assert not target.exists()
+    # Preserve fixture setup API for teardown diagnostics if a future edit fails.
+    assert callable(original_subprocess_run)
+
