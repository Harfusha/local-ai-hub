+def _action_type_with_aliases(tool_name: str, features: Any = None) -> Any:
+    actions = operation_actions(tool_name, features)
+    tool_kind = tool_name.removeprefix("local_ai_")
+    aliases = tuple(
+        alias for alias, canonical in _ACTION_ALIASES.get(tool_kind, {}).items()
+        if canonical in actions
+    )
+    return Literal.__getitem__(tuple(dict.fromkeys((*actions, *aliases))))
