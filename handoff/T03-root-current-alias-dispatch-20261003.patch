+def _expand_action_alias_schema(
+    tool_name: str, schema: dict[str, Any], actions: tuple[str, ...]
+) -> None:
+    """Advertise only enabled aliases and mirror canonical action constraints."""
+    properties = schema.get("properties", {})
+    action_schema = properties.get("action") if isinstance(properties, dict) else None
+    enum = action_schema.get("enum") if isinstance(action_schema, dict) else None
+    if not isinstance(enum, list):
+        return
+    tool_kind = tool_name.removeprefix("local_ai_")
+    aliases = {
+        alias: canonical
+        for alias, canonical in _ACTION_ALIASES.get(tool_kind, {}).items()
+        if canonical in actions
+    }
+    if not aliases:
+        return
+    action_schema["enum"] = list(dict.fromkeys((*enum, *aliases)))
+    conditions = schema.get("allOf")
+    if not isinstance(conditions, list):
+        return
+    expanded = list(conditions)
+    for condition in conditions:
+        if not isinstance(condition, dict):
+            continue
+        action_condition = (
+            condition.get("if", {}).get("properties", {}).get("action", {})
+        )
+        if not isinstance(action_condition, dict):
+            continue
+        canonical = action_condition.get("const")
+        if isinstance(canonical, str):
+            for alias, target in aliases.items():
+                if target != canonical:
+                    continue
+                alias_condition = deepcopy(condition)
+                alias_condition["if"]["properties"]["action"]["const"] = alias
+                expanded.append(alias_condition)
+        elif isinstance(action_condition.get("enum"), list):
+            action_condition["enum"] = list(dict.fromkeys((
+                *action_condition["enum"],
+                *(alias for alias, target in aliases.items() if target in action_condition["enum"]),
+            )))
+    schema["allOf"] = expanded
+
+
+def _mcp_input_schema(tool_name: str, features: Any) -> dict[str, Any]:
+    schema = operation_tool_input_schema(tool_name, features)
+    _expand_action_alias_schema(tool_name, schema, operation_actions(tool_name, features))
+    return schema
+
