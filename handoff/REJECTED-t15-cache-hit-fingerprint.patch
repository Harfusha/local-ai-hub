+from __future__ import annotations
+
+import json
+import os
+import statistics
+import sys
+import time
+from pathlib import Path
+
+from local_ai_hub.commands import CommandBroker, CommandInvocation
+from local_ai_hub.repo_state import RepoStateTracker
+
+
+class _Artifacts:
+    def put(self, *_args, **_kwargs):
+        return "artifact"
+
+
+def _percentile(values: list[float], fraction: float) -> float:
+    ordered = sorted(values)
+    position = (len(ordered) - 1) * fraction
+    lower = int(position)
+    upper = min(lower + 1, len(ordered) - 1)
+    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)
+
+
+def _command_broker(state_root: Path) -> CommandBroker:
+    config = {
+        "server": {"state_dir": str(state_root / "state")},
+        "workspace_cache": {"fingerprint_ttl_seconds": 60.0},
+        "commands": {
+            "enabled": True,
+            "coalesced_wait_seconds": 2,
+            "max_output_chars": 4096,
+        },
+    }
+    return CommandBroker(config, _Artifacts(), RepoStateTracker(config))
+
+
+class _RevisionState:
+    def __init__(self) -> None:
+        self.revision = "revision-a"
+        self.invalidations = 0
+
+    def fingerprint(self, _root: str) -> dict[str, str | bool]:
+        return {
+            "success": True,
+            "kind": "git",
+            "fingerprint": self.revision,
+            "degraded": False,
+            "stale": False,
+        }
+
+    def invalidate(self, _root: str | None = None) -> None:
+        self.invalidations += 1
+
+
+def test_warm_command_reuses_tracker_fingerprint_and_still_keys_new_revision(
+    tmp_path: Path, monkeypatch
+) -> None:
+    repo_state = _RevisionState()
+    config = {
+        "server": {"state_dir": str(tmp_path / "state")},
+        "commands": {"enabled": True},
+    }
+    broker = CommandBroker(config, _Artifacts(), repo_state)
+    command = "python -m pytest -q"
+    monkeypatch.setattr(broker, "_unavailable_executable", lambda *_args: None)
+    executions: list[str] = []
+
+    def execute(command, cwd, timeout, cancel_event=None, log_callback=None):
+        executions.append(command)
+        return {
+            "success": True,
+            "exit_code": 0,
+            "timed_out": False,
+            "cancelled": False,
+            "aborted_interactive": False,
+            "stdout": f"run-{len(executions)}",
+            "stderr": "",
+            "duration_ms": 0,
+        }
+
+    monkeypatch.setattr(broker, "_execute", execute)
+
+    first = broker.run(command, str(tmp_path), "tenant")
+    warm = broker.run(command, str(tmp_path), "tenant")
+    repo_state.revision = "revision-b"
+    changed = broker.run(command, str(tmp_path), "tenant")
+
+    assert first["cache_hit"] is False
+    assert warm["cache_hit"] is True
+    assert warm["stdout"] == first["stdout"]
+    assert changed["cache_hit"] is False
+    assert changed["repository_revision"] == "revision-b"
+    assert changed["stdout"] == "run-2"
+    assert executions == [command, command]
+    assert repo_state.invalidations == 0
+
+
+def _timed_run(
+    broker: CommandBroker,
+    command: str | CommandInvocation,
+    cwd: Path,
+    *,
+    force: bool,
+) -> tuple[dict, float]:
+    starts = time.perf_counter()
+    result = broker.run(command, str(cwd), "tenant", force=force)
+    return result, (time.perf_counter() - starts) * 1000
+
+
+def _assert_git_revision(result: dict) -> None:
+    state = result["repo_state"]
+    assert state["success"] is True
+    assert state["kind"] == "git"
+    assert state["degraded"] is False
+    assert state["stale"] is False
+    assert result["repository_revision"] == state["fingerprint"]
+    assert result["repository_revision"]
+
+
+def _phase_percentiles(samples: list[dict[str, float]]) -> dict[str, dict[str, float]]:
+    names = sorted({name for sample in samples for name in sample})
+    return {
+        name: {
+            "p50": statistics.median(float(sample.get(name, 0.0)) for sample in samples),
+            "p95": _percentile(
+                [float(sample.get(name, 0.0)) for sample in samples], 0.95
+            ),
+        }
+        for name in names
+    }
+
+
+def _workload_metrics(
+    cold_ms: list[float],
+    repeat_ms: list[float],
+    cold_cache_hits: list[bool | None],
+    repeat_cache_hits: list[bool | None],
+    cold_phases: list[dict[str, float]],
+    repeat_phases: list[dict[str, float]],
+    *,
+    output_parity: bool,
+    same_revision: bool,
+) -> dict:
+    cold_executions = [
+        (elapsed, phases)
+        for elapsed, hit, phases in zip(cold_ms, cold_cache_hits, cold_phases)
+        if hit is False
+    ]
+    repeat_executions = [
+        (elapsed, phases)
+        for elapsed, hit, phases in zip(repeat_ms, repeat_cache_hits, repeat_phases)
+        if hit is False
+    ]
+    cached_repeats = [
+        elapsed for elapsed, hit in zip(repeat_ms, repeat_cache_hits) if hit is True
+    ]
+    cold_execution_ms = [elapsed for elapsed, _ in cold_executions]
+    repeat_execution_ms = [elapsed for elapsed, _ in repeat_executions]
+
+    def latency(samples: list[float]) -> dict[str, float] | None:
+        if not samples:
+            return None
+        return {"p50": statistics.median(samples), "p95": _percentile(samples, 0.95)}
+
+    def throughput(count: int, samples: list[float]) -> float | None:
+        elapsed = sum(samples)
+        return count / (elapsed / 1000) if count and elapsed > 0 else None
+
+    return {
+        "cold_requests": len(cold_ms),
+        "cold_actual_executions": len(cold_execution_ms),
+        "cold_cache_hits": sum(hit is True for hit in cold_cache_hits),
+        "cold_cache_status_unknown": sum(hit is None for hit in cold_cache_hits),
+        "repeat_requests": len(repeat_ms),
+        "repeat_actual_executions": len(repeat_execution_ms),
+        "cached_repeats": len(cached_repeats),
+        "repeat_cache_status_unknown": sum(hit is None for hit in repeat_cache_hits),
+        "repeat_cache_hit_rate": (
+            len(cached_repeats) / len(repeat_ms) if repeat_ms else None
+        ),
+        "cold_request_ms": latency(cold_ms),
+        "cold_execution_ms": latency(cold_execution_ms),
+        "repeat_request_ms": latency(repeat_ms),
+        "repeat_execution_ms": latency(repeat_execution_ms),
+        "cached_repeat_ms": latency(cached_repeats),
+        "cold_request_commands_per_second": throughput(len(cold_ms), cold_ms),
+        "cold_execution_commands_per_second": throughput(
+            len(cold_execution_ms), cold_execution_ms
+        ),
+        "repeat_request_commands_per_second": throughput(len(repeat_ms), repeat_ms),
+        "repeat_execution_commands_per_second": throughput(
+            len(repeat_execution_ms), repeat_execution_ms
+        ),
+        "cold_execution_phases_ms": _phase_percentiles(
+            [phases for _, phases in cold_executions]
+        ),
+        "repeat_execution_phases_ms": _phase_percentiles(
+            [phases for _, phases in repeat_executions]
+        ),
+        "output_parity": output_parity,
+        "same_revision": same_revision,
+    }
+
+
+def test_workload_metrics_separate_executions_and_cached_repeats() -> None:
+    metrics = _workload_metrics(
+        [10.0, 20.0],
+        [5.0, 10.0, 15.0],
+        [False, False],
+        [True, False, True],
+        [{"fingerprint": 2.0}, {"fingerprint": 4.0}],
+        [{"fingerprint": 0.0}, {"fingerprint": 6.0}, {"fingerprint": 0.0}],
+        output_parity=True,
+        same_revision=True,
+    )
+
+    assert metrics["cold_actual_executions"] == 2
+    assert metrics["repeat_actual_executions"] == 1
+    assert metrics["cached_repeats"] == 2
+    assert metrics["repeat_cache_hit_rate"] == 2 / 3
+    assert metrics["repeat_execution_ms"] == {"p50": 10.0, "p95": 10.0}
+    assert metrics["repeat_execution_phases_ms"]["fingerprint"] == {
+        "p50": 6.0,
+        "p95": 6.0,
+    }
+    assert metrics["output_parity"] is True
+    assert metrics["same_revision"] is True
+
