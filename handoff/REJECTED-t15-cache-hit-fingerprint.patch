+def test_command_broker_benchmarks_cpu_and_dual_stream_workloads(tmp_path: Path) -> None:
+    worktree = Path(__file__).resolve().parents[1]
+    assert (worktree / ".git").exists(), "benchmark must run inside a Git worktree"
+    broker = _command_broker(tmp_path)
+    # Keep the API compaction layer from replacing raw tail evidence with a stdout prefix.
+    broker.inline_chars = broker.max_output_chars * 2
+    cpu_code = (
+        "import hashlib\n"
+        "value=b'T15_CPU'\n"
+        "for _ in range(250000):\n"
+        "    value=hashlib.sha256(value).digest()\n"
+        "print('CPU_DIGEST:'+value.hex())\n"
+    )
+    streams_code = (
+        "import os; "
+        "[(os.write(1,b'O'*8192),os.write(2,b'E'*8192)) for _ in range(256)]; "
+        "os.write(1,b'OUT_TAIL_SENTINEL'); os.write(2,b'ERR_TAIL_SENTINEL')"
+    )
+    workloads = {
+        "cpu": CommandInvocation(argv=[sys.executable, "-c", cpu_code], cwd=str(worktree), shell=False),
+        "dual_stream": CommandInvocation(
+            argv=[sys.executable, "-c", streams_code], cwd=str(worktree), shell=False
+        ),
+    }
+    report: dict[str, dict] = {}
+    for workload_name, invocation in workloads.items():
+        cold_ms: list[float] = []
+        repeat_ms: list[float] = []
+        cold_cache_hits: list[bool | None] = []
+        repeat_cache_hits: list[bool | None] = []
+        cold_phases: list[dict[str, float]] = []
+        repeat_phases: list[dict[str, float]] = []
+        revisions: set[str] = set()
+        output_parity = True
+        for _ in range(3):
+            cold, elapsed = _timed_run(broker, invocation, worktree, force=True)
+            cold_ms.append(elapsed)
