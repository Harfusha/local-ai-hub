+    def unload_configured_models(
+        self,
+        *,
+        timeout_seconds: float = 3.0,
+        should_stop: Any | None = None,
+        deadline: float | None = None,
+    ) -> dict[str, Any]:
+        """Request a bounded unload and verify the resulting Ollama loaded set.
+
+        An unload acknowledgement alone does not prove that a model left `/api/ps`.
+        An empty loaded set does not prove physical VRAM reclamation.
+        """
+        if (
+            isinstance(timeout_seconds, bool)
+            or not isinstance(timeout_seconds, (int, float))
+            or not math.isfinite(timeout_seconds)
+            or timeout_seconds <= 0
+        ):
+            raise ValueError("timeout_seconds must be a finite positive number")
+        timeout = min(float(timeout_seconds), 5.0)
+        unload_deadline = time.monotonic() + timeout
+        if deadline is not None:
+            if isinstance(deadline, bool) or not isinstance(deadline, (int, float)) or not math.isfinite(deadline):
+                raise ValueError("deadline must be a finite monotonic timestamp")
+            unload_deadline = min(unload_deadline, float(deadline))
+
+        def stopped() -> bool:
+            if should_stop is None:
+                return False
+            try:
+                return bool(should_stop())
+            except Exception:
+                return False
+
+        def report(
+            *,
+            backend_available: bool,
+            requested: list[str],
+            remaining: list[str] | None,
+            failed: dict[str, str],
+            cancelled: bool = False,
+        ) -> dict[str, Any]:
+            verified = remaining is not None and all(name not in remaining for name in requested)
+            complete = remaining is not None and not remaining
+            unloaded = [name for name in requested if name not in remaining] if verified else []
+            result = {
+                "success": complete and not failed,
+                "backend_available": backend_available,
+                "requested": requested,
+                "unloaded": unloaded,
+                "remaining": remaining,
+                "failed": failed,
+                "verified": verified,
+                "complete": complete,
+                "unverified": remaining is None,
+                "physical_vram_reclaimed": False,
+            }
+            if cancelled:
+                result["cancelled"] = True
+            return result
+
+        def query(endpoint: str, payload: dict[str, Any] | None) -> dict[str, Any]:
+            if stopped():
+                return {"error": "unload cancelled", "preempted": True}
+            remaining = max(0.0, unload_deadline - time.monotonic())
+            if remaining <= 0:
+                return {"error": "unload deadline exceeded", "timed_out": True}
+            return self.request_interruptible(
+                endpoint,
+                payload,
+                should_stop if callable(should_stop) else (lambda: False),
+                timeout=remaining,
+            )
+
+        def row_names(rows: Any) -> tuple[list[str], list[str]]:
+            names: list[str] = []
+            errors: list[str] = []
+            if not isinstance(rows, list):
+                return names, ["model list is not an array"]
+            for index, row in enumerate(rows):
+                if not isinstance(row, dict):
+                    errors.append(f"model_row_{index} is not an object")
+                    continue
+                name = next(
+                    (value.strip() for field in ("name", "model")
+                     if isinstance((value := row.get(field)), str) and value.strip()),
+                    "",
+                )
+                if not name:
+                    errors.append(f"model_row_{index} has no usable name or model")
+                elif name not in names:
+                    names.append(name)
+            return names, errors
+
+        if stopped():
+            return report(backend_available=False, requested=[], remaining=None,
+                          failed={"operation": "unload cancelled"}, cancelled=True)
+        if time.monotonic() >= unload_deadline:
+            return report(backend_available=False, requested=[], remaining=None,
+                          failed={"operation": "unload deadline exceeded"})
+        if not bool(self.config.get("ollama", {}).get("enabled", False)):
+            return report(backend_available=False, requested=[], remaining=None,
+                          failed={"backend": "Ollama backend is disabled"})
+
+        try:
+            initial = query("/api/ps", None)
+        except Exception as exc:
+            initial = {"error": type(exc).__name__}
+        if stopped():
+            return report(backend_available=False, requested=[], remaining=None,
+                          failed={"operation": "unload cancelled"}, cancelled=True)
+        if not isinstance(initial, dict) or "error" in initial:
+            return report(backend_available=False, requested=[], remaining=None,
+                          failed={"backend": "Ollama loaded-model query failed"})
+        loaded, row_errors = row_names(initial.get("models"))
+        failed = {f"model_row_{index}": error for index, error in enumerate(row_errors)}
+        requested: list[str] = []
+        for index, model in enumerate(loaded):
+            if stopped():
+                failed.update({name: "unload cancelled" for name in loaded[index:]})
+                break
+            if time.monotonic() >= unload_deadline:
+                failed.update({name: "unload deadline exceeded" for name in loaded[index:]})
+                break
+            requested.append(model)
+            try:
+                response = query("/api/generate", {"model": model, "prompt": "", "keep_alive": 0})
+            except Exception as exc:
+                failed[model] = type(exc).__name__
+                continue
+            if stopped():
+                failed[model] = "unload cancelled"
+                continue
+            if not isinstance(response, dict) or response.get("done_reason") != "unload":
+                failed[model] = "unload failed or timed out"
+            else:
+                self._invalidate_loaded_cache()
+
+        if stopped():
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "unload cancelled before verification"}, cancelled=True)
+        if time.monotonic() >= unload_deadline:
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "unload deadline exceeded before verification"})
+        try:
+            verification = query("/api/ps", None)
+        except Exception as exc:
+            verification = {"error": type(exc).__name__}
+        if stopped():
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "unload cancelled during verification"}, cancelled=True)
+        if not isinstance(verification, dict) or "error" in verification:
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "post-unload /api/ps unavailable"})
+        remaining, verification_errors = row_names(verification.get("models"))
+        if verification_errors:
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "; ".join(verification_errors)})
+        if time.monotonic() >= unload_deadline:
+            return report(backend_available=True, requested=requested, remaining=None,
+                          failed={**failed, "verification": "unload deadline exceeded during verification"})
+        return report(backend_available=True, requested=requested, remaining=remaining, failed=failed)
+
     def generate(self, model: str, prompt: str, *, system: str | None = None, options: dict[str, Any] | None = None, keep_alive: str | None = None) -> dict[str, Any]:
         options = dict(options or {})
         payload: dict[str, Any] = {"model": model, "prompt": prompt, "stream": False, "options": options}
