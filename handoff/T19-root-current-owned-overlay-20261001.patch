+    actions = next(
+        ast.literal_eval(node.value)
+        for node in module.body
+        if isinstance(node, ast.Assign)
+        and any(isinstance(target, ast.Name) and target.id == "_REPO_ACTIONS" for target in node.targets)
+    )
+    assert "graph" not in actions
