+def test_project_command_context_cache_invalidates_symbolic_head_revision(
+    tmp_path: Path, monkeypatch
+) -> None:
+    project = tmp_path / "project"
+    project.mkdir()
+    (project / ".local-ai.toml").write_text(
+        '[commands.probe]\nargv = ["python", "-c", "print(\\\'stable\\\')"]\n',
+        encoding="utf-8",
+    )
+    (project / "revision.txt").write_text("one\n", encoding="utf-8")
+
+    def git(*args: str) -> str:
+        result = subprocess.run(
+            ["git", *args], cwd=project, check=True, capture_output=True, text=True
+        )
+        return result.stdout.strip()
+
+    git("init", "--quiet")
+    git("config", "user.name", "T15 Fixture")
+    git("config", "user.email", "t15@example.invalid")
+    git("add", ".local-ai.toml", "revision.txt")
+    git("commit", "--quiet", "-m", "revision one")
+    assert git("symbolic-ref", "HEAD").startswith("refs/heads/")
+
+    calls = 0
+    original = project_config.resolve_project_context
+
+    def counted_context(root, state_dir):
+        nonlocal calls
+        calls += 1
+        return original(root, state_dir)
+
+    monkeypatch.setattr(project_config, "resolve_project_context", counted_context)
+    broker = _broker(tmp_path)
+    broker._resolve_project_command("probe", str(project))
+    broker._resolve_project_command("probe", str(project))
+    assert calls == 1
+
+    (project / "revision.txt").write_text("two\n", encoding="utf-8")
+    git("add", "revision.txt")
+    git("commit", "--quiet", "-m", "revision two")
+    broker._resolve_project_command("probe", str(project))
+    assert calls == 2
+
