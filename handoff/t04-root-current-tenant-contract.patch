+    @staticmethod
+    def _valid_tenant(tenant: Any) -> bool:
+        return (
+            isinstance(tenant, str)
+            and 1 <= len(tenant) <= 128
+            and tenant.isascii()
+            and all(0x21 <= ord(char) <= 0x7E for char in tenant)
+        )
