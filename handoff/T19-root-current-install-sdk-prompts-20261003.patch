+from __future__ import annotations
+
+import ast
+import tomllib
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _methods() -> list[ast.FunctionDef | ast.AsyncFunctionDef]:
+    tree = ast.parse((ROOT / "src/local_ai_hub/client.py").read_text(encoding="utf-8"))
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "HubClient")
+    return [node for node in cls.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and not node.name.startswith("_")]
+
+
+def test_sdk_docs_cover_root_public_methods_and_literal_routes() -> None:
+    docs = (ROOT / "docs/PYTHON_SDK.md").read_text(encoding="utf-8")
+    methods = _methods()
+    missing_methods = sorted(method.name for method in methods if f"`{method.name}`" not in docs)
+    routes = {
+        call.args[0].value
+        for method in methods
+        for call in ast.walk(method)
+        if isinstance(call, ast.Call)
+        and isinstance(call.func, ast.Attribute)
+        and isinstance(call.func.value, ast.Name)
+        and call.func.value.id == "self"
+        and call.func.attr in {"get", "post", "request"}
+        and call.args
+        and isinstance(call.args[0], ast.Constant)
+        and isinstance(call.args[0].value, str)
+        and call.args[0].value.startswith("/api/")
+    }
+    assert not missing_methods
+    assert not sorted(route for route in routes if route not in docs)
+
+
+def test_sdk_request_and_post_kwargs_match_root_signature() -> None:
+    methods = {method.name: method for method in _methods()}
+    expected = {
+        "timeout": "30.0", "replay_safe": "False", "request_id": "None",
+        "operational_action": "None", "requires_heavy_work": "True", "cancel_event": "None",
+    }
+    request = methods["request"]
+    actual = {arg.arg: ast.unparse(default) if default is not None else "None" for arg, default in zip(request.args.kwonlyargs, request.args.kw_defaults)}
+    assert {key: actual.get(key) for key in expected} == expected
+    docs = (ROOT / "docs/PYTHON_SDK.md").read_text(encoding="utf-8")
+    request_line = next(line for line in docs.splitlines() if line.startswith("Use `get("))
+    assert all(f"{key}={value}" in request_line for key, value in expected.items())
+    assert "path_hints=None" in request_line
+    assert "path_hints" in docs and "/api/search" in docs and "/api/command" in docs
+
+
+def test_sdk_optional_extras_match_root_pyproject() -> None:
+    project = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
+    deps = project["project"]["optional-dependencies"]
+    assert deps["intel-accelerators"] == ["sentence-transformers[openvino]>=5.4,<6", "openvino>=2026.1,<2027"]
+    docs = (ROOT / "docs/PYTHON_SDK.md").read_text(encoding="utf-8")
+    assert "`sentence-transformers[openvino]` and `openvino`" in docs
+    assert all(f"`{extra}`" in docs for extra in deps)
+
+
+def test_install_and_update_prompts_link_sdk_and_gate_uncertain_retries() -> None:
+    for name in ("INSTALL_PROMPT.md", "UPDATE_PROMPT.md"):
+        text = (ROOT / "docs" / name).read_text(encoding="utf-8").casefold()
+        assert "[python sdk](python_sdk.md)" in text
+        assert "request_not_sent" in text and "outcome_unknown" in text
+        assert "not retry authorization" in text
