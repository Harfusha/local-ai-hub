+    assert result["state"] == "partial"
+    assert result["success"] is False
+    ordered_names = sorted(names)
+    assert result["pending"] == ordered_names[len(runtime.unload_calls) :]
+    assert result["remaining"] == ordered_names[len(runtime.unload_calls) :]
+    assert result["unloaded"] == ordered_names[: len(runtime.unload_calls)]
+    assert result["failures"] == {
+        name: "unload deadline reached" for name in result["pending"]
+    }
+    assert result["reason"] == "unload_deadline_exceeded"
+    assert result["deadline_seconds"] == operational_mode._GAMING_UNLOAD_DEADLINE_SECONDS
+    assert all(
+        timeout <= operational_mode._GAMING_UNLOAD_REQUEST_TIMEOUT_SECONDS
+        for timeout in runtime.request_timeouts + runtime.unload_timeouts
+    )
+    assert clock.now <= 100.0 + operational_mode._GAMING_UNLOAD_DEADLINE_SECONDS
