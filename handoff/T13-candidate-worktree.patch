+def test_ollama_unload_forwards_remaining_timeout():
+    runtime = OllamaRuntime.__new__(OllamaRuntime)
+    runtime.llama_cpp = type(
+        "NoLlamaModel",
+        (),
+        {"supports_model": lambda _self, _model: False},
+    )()
+    runtime.config = {"llama_cpp": {"fallback_to_ollama": True}}
+    calls = []
+    runtime.request = lambda endpoint, payload, timeout=None: calls.append(
