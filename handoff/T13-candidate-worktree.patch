+def test_gaming_unload_respects_deadline_and_reports_partial_progress(monkeypatch):
+    class Clock:
+        now = 100.0
+
+        def monotonic(self):
+            return self.now
+
+    clock = Clock()
+    monkeypatch.setattr(operational_mode.time, "monotonic", clock.monotonic)
+
+    class SlowRuntime(_FakeRuntime):
+        def __init__(self, names):
+            super().__init__(names)
+            self.request_timeouts = []
+
+        def request(self, endpoint, *, timeout=None):
+            assert endpoint == "/api/ps"
+            assert timeout is not None
+            self.request_timeouts.append(timeout)
+            clock.now += timeout
+            return {"models": [{"name": name} for name in self.names]}
+
+        def unload_model(self, name, *, timeout=None):
+            assert timeout is not None
+            clock.now += timeout
+            return super().unload_model(name, timeout=timeout)
+
+    names = [f"model-{index}" for index in range(12)]
+    runtime = SlowRuntime(names)
+
+    result = operational_mode.unload_ollama_models_for_gaming(
