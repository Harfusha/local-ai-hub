+
+def test_mode_command_does_not_fallback_after_uncertain_live_transition(
+    monkeypatch, tmp_path, capsys
+):
+    monkeypatch.setattr(
+        hubctl,
+        "load_config",
+        lambda _path=None: {"server": {"state_dir": str(tmp_path)}},
