+    def begin_resource_release(self):
+        token = str(len(self.resource_release_tokens) + 1)
+        self.resource_release_tokens.add(token)
+        return token
+
+    def end_resource_release(self, token):
+        self.resource_release_tokens.discard(token)
+
+    @contextmanager
