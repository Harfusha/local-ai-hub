diff --git a/tests/test_dashboard_operational_surfaces.py b/tests/test_dashboard_operational_surfaces.py
--- a/tests/test_dashboard_operational_surfaces.py
+++ b/tests/test_dashboard_operational_surfaces.py
@@ -56,6 +56,68 @@
     assert "Gaming mode active, but VRAM unload was incomplete." in mode_source
 
 
+def test_operator_surfaces_report_all_transition_failures() -> None:
+    import json
+    import shutil
+    import subprocess
+
+    node = shutil.which("node")
+    assert node is not None, "Node.js is required for the bounded dashboard projection test"
+    marker = "function projectActivityModeTransition(confirmed,data){"
+    start = DASHBOARD_HTML.index(marker)
+    end = DASHBOARD_HTML.index("\nasync function refreshActivityMode", start)
+    projection_js = DASHBOARD_HTML[start:end]
+    cases = [
+        {
+            "mode": "gaming",
+            "data": {
+                "runtime_unload": {"success": False},
+                "accelerator_release": {"success": False},
+                "job_cancellation": {"success": False},
+            },
+        },
+        {
+            "mode": "maintenance",
+            "data": {"job_cancellation": {"success": False}},
+        },
+        {
+            "mode": "gaming",
+            "data": {
+                "runtime_unload": {"success": True},
+                "accelerator_release": {"success": True},
+            },
+        },
+    ]
+    script = f"""
+const activityModeLabels={{active:'Active',gaming:'GAMING / PAUSED',maintenance:'Maintenance'}};
+{projection_js}
+const cases={json.dumps(cases)};
+console.log(JSON.stringify(cases.map(item=>projectActivityModeTransition(item.mode,item.data))));
+"""
+    result = subprocess.run(
+        [node, "-e", script], capture_output=True, text=True, check=True, timeout=3
+    )
+    projected = json.loads(result.stdout)
+
+    assert projected[0] == {
+        "modePersisted": True,
+        "partial": True,
+        "failures": [
+            "VRAM unload incomplete",
+            "accelerator release incomplete",
+            "job cancellation incomplete",
+        ],
+        "status": (
+            "Mode persisted as GAMING / PAUSED. Mode transition incomplete: "
+            "VRAM unload incomplete; accelerator release incomplete; job cancellation incomplete."
+        ),
+    }
+    assert projected[1]["status"] == (
+        "Mode persisted as Maintenance. Mode transition incomplete: job cancellation incomplete."
+    )
+    assert projected[2]["partial"] is False
+    assert projected[2]["status"] == "Mode set to GAMING / PAUSED."
+
 def test_recent_request_table_reserves_trace_and_duration_columns() -> None:
     assert ".work-panel-3 th:nth-child(8){width:12%}" in DASHBOARD_HTML
     assert ".work-panel-3 th:nth-child(9){width:7%}" in DASHBOARD_HTML
