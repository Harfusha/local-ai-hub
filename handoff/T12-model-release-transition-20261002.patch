+"""T12 acceptance test against the pinned T13/T11 root-current source overlay.
+
+The product modules remain owner-controlled by T13/T11 and are not copied into
+the T12 candidate. This test loads the reviewed overlay and exercises its real
+HTTP gaming transition with fake runtimes and tracked CUDA owners.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from pathlib import Path
+import sys
+import threading
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+
+REPO = Path(__file__).resolve().parents[1]
+OVERLAY_SRC = REPO / ".handoff" / "T12-root-current-overlay-20261001" / "src"
+sys.path.insert(0, str(OVERLAY_SRC))
+
+from local_ai_hub import http_server, model_lifecycle  # noqa: E402
+
+assert Path(http_server.__file__).resolve() == OVERLAY_SRC / "local_ai_hub" / "http_server.py"
+assert Path(model_lifecycle.__file__).resolve() == OVERLAY_SRC / "local_ai_hub" / "model_lifecycle.py"
+
+
+class _ModeRegistry:
+    def __init__(self, events: list[str], name: str, *, active: bool = False) -> None:
+        self.events = events
+        self.name = name
+        self.active = active
+
+    def active_count(self) -> int:
+        return int(self.active)
+
+    def enter_gaming(self) -> None:
+        self.events.append(f"{self.name}:gaming")
+
+    def enter_active(self) -> None:
+        self.events.append(f"{self.name}:active")
+
+    def cancel_and_wait(self, _timeout: float) -> dict[str, Any]:
+        self.events.append(f"{self.name}:cancel_and_wait")
+        return {"success": True, "inference_active": self.active}
+
+    def when_drained(self, callback) -> None:
+        callback()
+
+
+class _AsyncJobs:
+    def __init__(self, events: list[str], *, drained: bool) -> None:
+        self.events = events
+        self.drained = drained
+        self.deferred_release = None
+
+    @contextmanager
+    def operational_mode_change_guard(self):
+        yield
+
+    def on_operational_mode_changed(self, _snapshot) -> None:
+        self.events.append("jobs:cancel_requested")
+
+    def resource_release_active(self) -> bool:
+        return False
+
+    def begin_resource_release(self) -> str:
+        self.events.append("jobs:release_guard_started")
+        return "release-token"
+
+    def wait_for_inference_actions(self, _actions, _timeout: float) -> bool:
+        self.events.append("jobs:inference_drain")
+        return self.drained
+
+    def inference_actions_active(self) -> bool:
+        return not self.drained
+
+    def when_inference_actions_drained(self, _actions, callback) -> None:
+        self.deferred_release = callback
+
+    def end_resource_release(self, token: str) -> None:
+        self.events.append(f"jobs:release_guard_ended:{token}")
+
+
+class _CudaOwner:
+    def __init__(self, name: str, events: list[str]) -> None:
+        self.name = name
+        self.events = events
+        self.loaded = False
+        self._owner_lock = threading.Lock()
+
+    def load(self) -> None:
+        model_lifecycle.load_model(self, uses_cuda=True, factory=object)
+        self.loaded = True
+
+    def status(self) -> dict[str, Any]:
+        return {"loaded": self.loaded, "active_backend": "torch"}
+
+    def release(self, *, timeout_seconds: float) -> bool:
+        self.events.append(f"cuda_release:{self.name}")
+        if not self._owner_lock.acquire(timeout=min(timeout_seconds, 0.05)):
+            return False
+        try:
+            if self.loaded:
+                self.loaded = False
+                model_lifecycle.release_model(self, used_cuda=True)
+            return True
+        finally:
+            self._owner_lock.release()
+
+
+def _post_gaming(monkeypatch, tmp_path: Path, *, events, jobs, runtime, embeddings, reranker):
+    monkeypatch.setattr(http_server, "_ACTIVE_TRANSCRIPTIONS", _ModeRegistry(events, "transcription"))
+    monkeypatch.setattr(http_server, "_ACTIVE_CONVERSATIONS", _ModeRegistry(events, "conversation"))
+    app = SimpleNamespace(
+        config={"server": {"state_dir": str(tmp_path)}},
+        recovery=None,
+        async_jobs=jobs,
+        preprocessor=SimpleNamespace(status=lambda: {"success": True, "projects": []}),
+        runtime=runtime,
+        embeddings=embeddings,
+        reranker=reranker,
+    )
+    monkeypatch.setattr(http_server, "APP", app)
+    responses: list[tuple[int, dict[str, Any]]] = []
+    handler = object.__new__(http_server.Handler)
+    handler.path = "/api/admin/mode"
+    handler._require_authorized = lambda: True
+    handler._begin_trace = lambda _path: None
+    handler._read_json = lambda: {"mode": "gaming"}
+    handler._send = lambda status, body, **_kwargs: responses.append((status, body))
+    handler.do_POST()
+    assert len(responses) == 1
+    return responses[0]
+
+
+def test_gaming_transition_drains_then_unloads_both_cuda_owners_before_empty_cache(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    events: list[str] = []
+    owners: list[_CudaOwner] = []
+
+    class FakeCuda:
+        @staticmethod
+        def synchronize() -> None:
+            events.append("cuda:synchronize")
+
+        @staticmethod
+        def empty_cache() -> None:
+            assert all(not owner.loaded for owner in owners)
+            events.append("cuda:empty_cache")
+
+    monkeypatch.setitem(sys.modules, "torch", SimpleNamespace(cuda=FakeCuda()))
+    embeddings = _CudaOwner("embeddings", events)
+    reranker = _CudaOwner("reranker", events)
+    owners.extend((embeddings, reranker))
+    embeddings.load()
+    reranker.load()
+    jobs = _AsyncJobs(events, drained=True)
+
+    class Runtime:
+        def unload_configured_models(self, *, timeout_seconds: float) -> dict[str, Any]:
+            assert timeout_seconds == 3.0
+            events.append("ollama:unload")
+            return {"success": True, "verified": True, "unloaded": ["ollama-model"]}
+
+    status, response = _post_gaming(
+        monkeypatch, tmp_path, events=events, jobs=jobs, runtime=Runtime(),
+        embeddings=embeddings, reranker=reranker,
+    )
+
+    assert status == 200
+    assert response["runtime_unload"]["success"] is True
+    assert response["accelerator_release"] == {
+        "success": True, "verified": True, "released": ["embeddings", "reranker"], "failed": {},
+    }
+    assert events.index("jobs:cancel_requested") < events.index("jobs:inference_drain")
+    assert events.index("jobs:inference_drain") < events.index("ollama:unload")
+    assert events.index("ollama:unload") < events.index("cuda_release:embeddings")
+    assert events.index("cuda_release:reranker") < events.index("cuda:empty_cache")
+    assert events.count("cuda:empty_cache") == 1
+
+
+def test_gaming_transition_skips_all_release_when_inference_did_not_drain(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    events: list[str] = []
+    embeddings = _CudaOwner("embeddings", events)
+    reranker = _CudaOwner("reranker", events)
+    embeddings.load()
+    reranker.load()
+    jobs = _AsyncJobs(events, drained=False)
+
+    class Runtime:
+        def unload_configured_models(self, **_kwargs):
+            pytest.fail("gaming transition must not unload while inference is active")
+
+    status, response = _post_gaming(
+        monkeypatch, tmp_path, events=events, jobs=jobs, runtime=Runtime(),
+        embeddings=embeddings, reranker=reranker,
+    )
+
+    assert status == 200
+    assert response["runtime_unload"]["state"] == "skipped_active_inference"
+    assert response["accelerator_release"]["state"] == "skipped_active_inference"
+    assert embeddings.loaded and reranker.loaded
+    assert not any(event.startswith("cuda_release:") for event in events)
+    assert "jobs:release_guard_ended:release-token" not in events
+    assert jobs.deferred_release is not None
+
+
+def test_busy_cuda_owner_failure_keeps_shared_allocator_cache_owned(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    events: list[str] = []
+    embeddings = _CudaOwner("embeddings", events)
+    reranker = _CudaOwner("reranker", events)
+    embeddings.load()
+    reranker.load()
+    monkeypatch.setitem(sys.modules, "torch", SimpleNamespace(cuda=SimpleNamespace(
+        synchronize=lambda: events.append("cuda:synchronize"),
+        empty_cache=lambda: events.append("cuda:empty_cache"),
+    )))
+    jobs = _AsyncJobs(events, drained=True)
+
+    class Runtime:
+        def unload_configured_models(self, **_kwargs):
+            events.append("ollama:unload")
+            return {"success": True, "verified": True, "unloaded": ["ollama-model"]}
+
+    inference_holds_lock = threading.Event()
+    finish_inference = threading.Event()
+
+    def active_inference() -> None:
+        with embeddings._owner_lock:
+            inference_holds_lock.set()
+            finish_inference.wait(timeout=2.0)
+
+    worker = threading.Thread(target=active_inference, name="fake-cuda-inference")
+    worker.start()
+    assert inference_holds_lock.wait(timeout=1.0)
+    try:
+        status, response = _post_gaming(
+            monkeypatch, tmp_path, events=events, jobs=jobs, runtime=Runtime(),
+            embeddings=embeddings, reranker=reranker,
+        )
+    finally:
+        finish_inference.set()
+        worker.join(timeout=1.0)
+    assert not worker.is_alive()
+
+    assert status == 200
+    release = response["accelerator_release"]
+    assert release["success"] is False
+    assert release["verified"] is False
+    assert release["failed"] == {"embeddings": "TimeoutError"}
+    assert embeddings.loaded is True
+    assert reranker.loaded is False
+    assert "cuda:empty_cache" not in events
