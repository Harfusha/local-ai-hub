+
+    monkeypatch.setattr(local_ai_mcp, "HubClient", fake_client)
+    client = local_ai_mcp._build_mcp_client("agent:workspace", "hub.toml")
+
+    assert client is not None
+    assert captured == {
+        "tenant": "agent:workspace",
+        "config_path": "hub.toml",
+        "auto_start": True,
+    }
 
 
