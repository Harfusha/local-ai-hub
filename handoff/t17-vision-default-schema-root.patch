--- a/tests/test_vision_service.py
+++ b/tests/test_vision_service.py
@@ -798,3 +798,28 @@
     assert profile.tier == "vision"
     assert profile.parallel_limit == 1
     assert override_profile.tier == "vision"
+
+def test_vision_ollama_uses_default_grounded_json_schema(tmp_path: Path) -> None:
+    services, runtime, image = _services(tmp_path)
+    services.config["ollama"] = {"enabled": True}
+    runtime.request.return_value = {
+        "response": json.dumps({
+            "summary": "No findings.",
+            "findings": [],
+            "unknowns": [],
+            "recommended_checks": [],
+        })
+    }
+
+    result = services.vision({"image": str(image), "prompt": "Review UI"}, "t")
+
+    assert result["success"] is True
+    schema = runtime.request.call_args.args[1]["format"]
+    assert isinstance(schema, dict)
+    assert schema["additionalProperties"] is False
+    finding = schema["properties"]["findings"]["items"]
+    assert "observation_facts" in finding["required"]
+    assert finding["properties"]["observation_facts"]["items"]["required"] == [
+        "source", "element_id", "field", "value"
+    ]
+
