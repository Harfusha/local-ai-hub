diff --git a/tests/test_mcp_contract_dispatch.py b/tests/test_mcp_contract_dispatch.py
--- a/tests/test_mcp_contract_dispatch.py
+++ b/tests/test_mcp_contract_dispatch.py
@@ -539,0 +540,33 @@
+
+def test_mcp_repo_search_forwards_path_hints_to_http_payload(monkeypatch) -> None:
+    from local_ai_hub import mcp_server
+
+    calls = []
+    hints = [{"path": "src/local_ai_hub", "purpose": "repository_search", "scope": "repo_search"}]
+
+    class CapturingClient:
+        def post(self, path, payload=None, *, timeout=30.0):
+            calls.append((path, payload))
+            return {"success": True, "results": []}
+
+    monkeypatch.setattr(mcp_server, "CLIENT", CapturingClient())
+    monkeypatch.setattr(mcp_server, "_client_root", lambda root: root)
+
+    result = mcp_server.local_ai_repo(
+        action="search", root="C:/repo", query="auth", path_hints=hints
+    )
+
+    assert result["success"] is True
+    search_calls = [call for call in calls if call[0] == "/api/search"]
+    assert search_calls == [
+        (
+            "/api/search",
+            {
+                "root": "C:/repo",
+                "query": "auth",
+                "top_k": 12,
+                "enrich": False,
+                "path_hints": hints,
+            },
+        )
+    ]
