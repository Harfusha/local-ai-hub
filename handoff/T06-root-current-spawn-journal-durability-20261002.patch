+        _local_ai_job_handle = None
+
+        def __init__(self) -> None:
+            self.alive = True
+
+        def poll(self) -> int | None:
+            return None if self.alive else 1
+
+        def kill(self) -> None:
+            self.alive = False
+
+        def wait(self, timeout: float | None = None) -> int:
+            self.alive = False
+            return 1
