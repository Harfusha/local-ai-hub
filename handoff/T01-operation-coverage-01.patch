+    )
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        ["hubctl.py", "service-status", "--config", str(config_path)],
+    )
+
+    result = hubctl.main()
+
+    assert result == 0
+    assert capsys.readouterr().out == payload + "\n"
+
+
+def test_hubctl_start_dispatches_start_and_reports_success(monkeypatch, capsys):
