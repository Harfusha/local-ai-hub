+    services.config = {"server": {"state_dir": str(tmp_path / "runtime")}, "features": {}}
+    services.repo_flight = Flight()
+    services._touch_project = lambda _root: None
+    services._repo_cache_state = lambda _root: {"fingerprint": "rev", "stale": False}
