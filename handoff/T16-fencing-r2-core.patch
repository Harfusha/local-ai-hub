+    def _schedule_recovery_retry(self) -> None:
+        """Retry deferred crash recovery while a prior writer's lease is live."""
+        if self._stop.is_set():
+            return
+        with self._lock:
+            if self._recovery_timer is not None and self._recovery_timer.is_alive():
