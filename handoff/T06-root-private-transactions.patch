+    def _transaction_file_matches(left: RollbackFileSnapshot, right: RollbackFileSnapshot) -> bool:
+        return (
+            left.content == right.content
+            and left.mode == right.mode
+            and left.xattrs == right.xattrs
+            and left.mtime_ns == right.mtime_ns
+        )
