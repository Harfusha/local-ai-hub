+                    return result
+                result.update({
+                    "success": False,
+                    "transaction_status": "discarded",
+                    "failure_kind": (
+                        "timeout" if execution.get("timed_out") else
+                        "cancelled" if execution.get("cancelled") else "command_failed"
+                    ),
+                    "outcome_unknown": False,
+                    "rolled_back": True,
+                    "source_unchanged": True,
+                    "retryable": False,
+                    "terminal": True,
