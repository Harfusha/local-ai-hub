+                        should_stop,
+                        timeout=remaining,
+                        deadline=absolute_deadline,
+                    )
+                    return response if isinstance(response, dict) else {"error": "runtime returned non-object"}
+                finally:
+                    with running_lock:
+                        running_count = max(0, running_count - 1)
