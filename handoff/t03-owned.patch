+        if action in {"batch_replace", "ast_refactor", "validate_patch", "verify_completion", "verify_receipt"}:
+            return {"valid": {"type": "boolean"}, "issues": array_object, "changed_paths": {"type": "array", "items": string_value}}
+        if action in {"pipeline"}:
