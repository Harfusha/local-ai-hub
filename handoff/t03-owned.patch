+                "summary": {"type": "object", "properties": summary_fields, "additionalProperties": True},
+                "queue": {"type": "object"}, "hotspots": {"type": "array", "items": {"type": "object"}},
+                "by_operation": {"type": "array", "items": {"type": "object"}},
