@@ -0,0 +1,55 @@
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from local_ai_hub import http_server
+
+
+def test_invalid_request_id_returns_400_before_body_journal_or_dispatch(monkeypatch) -> None:
+    journal_calls: list[str] = []
+    body_reads: list[bool] = []
+    responses: list[tuple[int, dict[str, object]]] = []
+    dispatches: list[bool] = []
+
+    class _Journal:
+        def begin(self, *_args, **_kwargs) -> None:
+            journal_calls.append("begin")
+
+    monkeypatch.setattr(
+        http_server,
+        "APP",
+        SimpleNamespace(
+            recovery=_Journal(),
+            config={},
+            work_orchestrator=SimpleNamespace(
+                enabled=True,
+                submit=lambda *_args, **_kwargs: dispatches.append(True) or {"success": True},
+            ),
+        ),
+    )
+    monkeypatch.setattr(
+        http_server.Handler,
+        "_begin_trace",
+        lambda self, _path: setattr(self, "_trace_request_id", self.headers.get("X-LocalAI-Request-ID", "")),
+    )
+    monkeypatch.setattr(http_server.Handler, "_require_authorized", lambda _self: True)
+
+    def read_json(_self):
+        body_reads.append(True)
+        return {"action": "submit"}
+
+    monkeypatch.setattr(http_server.Handler, "_read_json", read_json)
+    monkeypatch.setattr(http_server.Handler, "_send", lambda _self, status, data: responses.append((status, data)))
+    monkeypatch.setattr(http_server.Handler, "_validate_payload", lambda _self, _path, _payload: None)
+    handler = object.__new__(http_server.Handler)
+    handler.path = "/api/work-orders"
+    handler.headers = {"Content-Type": "application/json", "X-LocalAI-Request-ID": "bad id"}
+
+    http_server.Handler.do_POST(handler)
+
+    assert responses[0][0] == 400
+    assert responses[0][1]["terminal"] is True
+    assert responses[0][1]["retryable"] is False
+    assert body_reads == []
+    assert journal_calls == []
+    assert dispatches == []
