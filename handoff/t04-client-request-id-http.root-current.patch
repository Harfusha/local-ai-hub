+from __future__ import annotations
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from local_ai_hub.client import HubClient
+
+
+def test_safe_http_retry_reuses_explicit_request_id(tmp_path) -> None:
+    request_ids: list[str | None] = []
+    request_bodies: list[dict[str, object]] = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self) -> None:
+            length = int(self.headers.get("Content-Length", "0"))
+            request_ids.append(self.headers.get("X-LocalAI-Request-ID"))
+            request_bodies.append(json.loads(self.rfile.read(length).decode("utf-8")))
+            request_id = self.headers.get("X-LocalAI-Request-ID")
+            if len(request_ids) == 1:
+                status = 503
+                payload = {
+                    "success": False,
+                    "in_progress": True,
+                    "retryable": True,
+                    "retry_after_seconds": 0.01,
+                    "request_id": request_id,
+                }
+            else:
+                status = 200
+                payload = {"success": True, "request_id": request_id}
+            response = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(response)))
+            self.end_headers()
+            self.wfile.write(response)
+
+        def log_message(self, *_args) -> None:
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    config_path = tmp_path / "client.toml"
+    config_path.write_text(
+        f'[server]\nbind="127.0.0.1"\nport={server.server_port}\n'
+        f'state_dir="{(tmp_path / "state").as_posix()}"\n'
+        "[client]\nmax_request_timeout_seconds=5\n",
+        encoding="utf-8",
+    )
+    client = HubClient(config_path=str(config_path), tenant="request-id-test", auto_start=False)
+    request_id = "stable-http-retry-id"
+    body = {"command": "safe"}
+    try:
+        result = client.request(
+            "/api/command",
+            body,
+            timeout=2,
+            replay_safe=True,
+            request_id=request_id,
+        )
+    finally:
+        client._drop_connection()
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+
+    assert result == {"success": True, "request_id": request_id}
+    assert request_ids == [request_id, request_id]
+    assert request_bodies == [body, body]
