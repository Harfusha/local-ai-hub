+    def unload_configured_models(self, *, timeout_seconds: float = 3.0) -> dict[str, Any]:
+        """Best-effort, bounded unload of configured models that are currently loaded.
+
+        Pause never starts a backend or loads a model. A single deadline covers the
+        loaded-model query and every unload request. The helper does not issue an
+        inference-cancel request; the backend decides how an in-flight runner reacts.
+        Failed or timed-out unloads are reported without retrying at this layer.
+        """
+        if (
+            isinstance(timeout_seconds, bool)
+            or not isinstance(timeout_seconds, (int, float))
+            or not math.isfinite(timeout_seconds)
+            or timeout_seconds <= 0
+        ):
+            raise ValueError("timeout_seconds must be a finite positive number")
+
+        timeout = min(float(timeout_seconds), _GAMING_UNLOAD_MAX_TIMEOUT_SECONDS)
+        deadline = time.monotonic() + timeout
+        unloaded: list[str] = []
+        failed: dict[str, str] = {}
+        ollama_enabled = bool(self.config.get("ollama", {}).get("enabled", False))
+
+        if ollama_enabled:
+            try:
+                response = self.request("/api/ps", timeout=timeout, deadline=deadline)
+            except Exception:
+                response = {"error": "backend unavailable"}
+            if (
+                not isinstance(response, dict)
+                or "error" in response
+                or not isinstance(response.get("models"), list)
+            ):
+                return {
+                    "success": False,
+                    "backend_available": False,
+                    "unloaded": unloaded,
+                    "failed": {"backend": "backend unavailable"},
+                }
+            loaded_rows = response["models"]
+            backend_available = True
+        else:
+            adapter_models = self.config.get("llama_cpp", {}).get("models", {})
+            if not isinstance(adapter_models, dict) or not adapter_models:
+                return {
+                    "success": True,
+                    "backend_available": False,
+                    "unloaded": unloaded,
+                    "failed": failed,
+                }
+            try:
+                available_models = self.llama_cpp.available_models(deadline=deadline)
+                if not available_models or time.monotonic() >= deadline:
+                    raise TimeoutError("backend unavailable")
+                loaded_rows = self.llama_cpp.loaded_model_details(deadline=deadline)
+            except Exception:
+                return {
+                    "success": False,
+                    "backend_available": False,
+                    "unloaded": unloaded,
+                    "failed": {"backend": "backend unavailable"},
+                }
+            backend_available = True
+
+        loaded_models: list[str] = []
+        for row_index, row in enumerate(loaded_rows):
+            if not isinstance(row, dict):
+                failed[f"model_row_{row_index}"] = "loaded model row is not an object"
+                continue
+            model = ""
+            for field in ("name", "model"):
+                value = row.get(field)
+                if isinstance(value, str) and value.strip():
+                    model = value.strip()
+                    break
+            if not model:
+                failed[f"model_row_{row_index}"] = "loaded model row has no usable name or model"
+                continue
+            # Preserve model tags (`name:tag`) exactly; trim only outer whitespace.
+            if model not in loaded_models:
+                loaded_models.append(model)
+
+        for model in loaded_models:
+            if time.monotonic() >= deadline:
+                failed[model] = "unload deadline exceeded"
+                continue
+            try:
+                if ollama_enabled:
+                    remaining = max(0.05, deadline - time.monotonic())
+                    response = self.request(
+                        "/api/generate",
+                        {"model": model, "prompt": "", "keep_alive": 0},
+                        timeout=remaining,
+                        deadline=deadline,
+                    )
+                    ok = (
+                        isinstance(response, dict)
+                        and "error" not in response
+                        and response.get("done_reason") == "unload"
+                    )
+                    if ok:
+                        self._invalidate_loaded_cache()
+                else:
+                    ok = self.llama_cpp.unload_model(model, deadline=deadline)
+            except Exception as exc:
+                failed[model] = type(exc).__name__
+                continue
+
+            if ok:
+                unloaded.append(model)
+            else:
+                failed[model] = "unload failed or timed out"
+
+        return {
+            "success": not failed,
+            "backend_available": backend_available,
+            "unloaded": unloaded,
+            "failed": failed,
+        }
