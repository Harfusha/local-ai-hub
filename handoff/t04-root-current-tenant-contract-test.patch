+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from urllib.parse import quote
+
+from local_ai_hub.client import HubClient
+
+
+def _client(tmp_path: Path) -> HubClient:
+    state_dir = tmp_path / "state"
+    config_path = tmp_path / "hub.toml"
+    config_path.write_text(
+        f'[server]\nbind="127.0.0.1"\nport=39131\nstate_dir={json.dumps(state_dir.as_posix())}\n'
+        + '[security]\napi_token="fallback-api-token"\napi_token_tenant="auth-principal"\n'
+        + 'tenant_derivation_key="configured-derivation-secret"\n'
+        + f'allowed_roots=[{json.dumps(tmp_path.as_posix())}]\n',
+        encoding="utf-8",
+    )
+    return HubClient(tenant="", config_path=str(config_path), auto_start=False)
+
+
+def _expected_tenant(client: HubClient, root: Path) -> str:
+    security = client.config["security"]
+    principal = str(security.get("api_token_tenant") or security.get("api_token_principal") or "api-token-default")
+    key = str(security.get("tenant_derivation_key") or security.get("api_token") or "")
+    canonical = str(root.resolve(strict=True))
+    message = f"local-ai-root-tenant\0{principal}\0{canonical}".encode("utf-8")
+    return "root-" + hmac.new(key.encode("utf-8"), message, hashlib.sha256).hexdigest()
+
+
+def test_same_task_id_uses_canonical_root_tenant_per_concurrent_request(tmp_path, monkeypatch):
+    client = _client(tmp_path)
+    roots = [tmp_path / "repo-a", tmp_path / "repo-b"]
+    for root in roots:
+        root.mkdir()
+    barrier = threading.Barrier(2)
+    observed = []
+    lock = threading.Lock()
+
+    def capture(_method, path, body, headers, _timeout):
+        barrier.wait(timeout=5)
+        with lock:
+            observed.append((path, json.loads(body.decode("utf-8")), dict(headers)))
+        return b'{"success":true}'
+
+    monkeypatch.setattr(client, "_pooled_open", capture)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(
+            lambda root: client.post(
+                "/api/agent-state/tasks",
+                {"action": "get", "task_id": "shared-id", "root": str(root)},
+                request_id="shared-request-id",
+            ),
+            roots,
+        ))
+
+    assert results == [{"success": True}, {"success": True}]
+    assert len(observed) == 2
+    by_root = {Path(payload["root"]): headers for _path, payload, headers in observed}
+    assert by_root[roots[0]]["X-LocalAI-Tenant"] == _expected_tenant(client, roots[0])
+    assert by_root[roots[1]]["X-LocalAI-Tenant"] == _expected_tenant(client, roots[1])
+    assert by_root[roots[0]]["X-LocalAI-Tenant"] != by_root[roots[1]]["X-LocalAI-Tenant"]
+    assert client.tenant == ""
+
+
+def test_body_tenant_is_consistency_hint_not_scope_override(tmp_path, monkeypatch):
+    client = _client(tmp_path)
+    root = tmp_path / "repo"
+    root.mkdir()
+    calls = []
+    monkeypatch.setattr(client, "_pooled_open", lambda *args, **kwargs: calls.append(args))
+
+    result = client.post(
+        "/api/agent-state/tasks",
+        {"action": "get", "task_id": "task-a", "root": str(root), "tenant": "attacker-selected"},
+    )
+
+    assert result["error_code"] == "tenant_binding_mismatch"
+    assert result["terminal"] is True
+    assert result["retryable"] is False
+    assert calls == []
+
+
+def test_rootless_memory_binds_to_authenticated_principal(tmp_path, monkeypatch):
+    client = _client(tmp_path)
+    observed = []
+    monkeypatch.setattr(
+        client,
+        "_pooled_open",
+        lambda _method, path, body, headers, _timeout: observed.append((path, dict(headers))) or b'{"success":true}',
+    )
+
+    result = client.post("/api/agent-state/memory", {"action": "find", "scope": "global"})
+
+    assert result == {"success": True}
+    assert observed[0][1]["X-LocalAI-Tenant"] == "auth-principal"
+    assert observed[0][1]["X-LocalAI-Tenant"] != f"agent-{__import__('os').getpid()}"
+
+
+def test_root_scoped_memory_get_derives_header_and_rejects_mismatched_query(tmp_path, monkeypatch):
+    client = _client(tmp_path)
+    root = tmp_path / "repo"
+    root.mkdir()
+    observed = []
+    monkeypatch.setattr(
+        client,
+        "_pooled_open",
+        lambda _method, path, _body, headers, _timeout: observed.append((path, dict(headers))) or b'{"success":true}',
+    )
+    result = client.get(f"/api/agent-state/memory?scope=session&root={quote(str(root))}")
+    rejected = client.get(
+        f"/api/agent-state/memory?scope=session&root={quote(str(root))}&tenant=wrong-tenant"
+    )
+
+    assert result == {"success": True}
+    assert observed[0][1]["X-LocalAI-Tenant"] == _expected_tenant(client, root)
+    assert rejected["error_code"] == "tenant_binding_mismatch"
+    assert len(observed) == 1
+
+
+def test_default_client_omits_pid_tenant_header(tmp_path, monkeypatch):
+    client = _client(tmp_path)
+    observed = []
+    monkeypatch.setattr(
+        client,
+        "_pooled_open",
+        lambda _method, _path, _body, headers, _timeout: observed.append(dict(headers)) or b'{"success":true}',
+    )
+
+    assert client.get("/health") == {"success": True}
+    assert "X-LocalAI-Tenant" not in observed[0]
