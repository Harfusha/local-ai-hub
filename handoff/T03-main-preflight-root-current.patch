+def test_stdio_main_does_not_gate_handshake_on_hub_startup(monkeypatch) -> None:
+    from local_ai_hub import mcp_server
+
+    startup_calls: list[float | None] = []
+    run_calls: list[bool] = []
+
+    def fail_startup(*, timeout=None):
+        startup_calls.append(timeout)
+        return False
+
+    monkeypatch.setattr(mcp_server.CLIENT, "ensure_server", fail_startup)
+    monkeypatch.setattr(mcp_server.mcp, "run", lambda: run_calls.append(True))
+
+    mcp_server.main()
+
+    assert startup_calls == []
+    assert run_calls == [True]
