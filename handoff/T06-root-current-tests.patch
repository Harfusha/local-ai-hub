+def test_git_mutation_helpers_reject_replaced_registered_worktree(tmp_path: Path) -> None:
+    source = tmp_path / "source"
+    source.mkdir()
+    registered = tmp_path / "task-worktree"
+
+    def git(cwd: Path, *args: str) -> subprocess.CompletedProcess[str]:
+        return subprocess.run(
+            ["git", *args], cwd=str(cwd), capture_output=True, text=True,
+            check=True, **hidden_run_kwargs()
+        )
+
+    git(source, "init")
+    git(source, "config", "user.name", "Test")
+    git(source, "config", "user.email", "test@example.com")
+    (source / "seed.txt").write_text("seed\n", encoding="utf-8")
+    git(source, "add", "seed.txt")
+    git(source, "commit", "-m", "seed")
+    git(source, "worktree", "add", "-b", "task/owned", str(registered), "HEAD")
+    task_store = _FakeTaskStore(
+        str(registered), repo_root=str(source), branch="task/owned"
+    )
+
+    git(source, "worktree", "remove", "--force", str(registered))
+    registered.mkdir()
+    git(registered, "init")
+    git(registered, "checkout", "-b", "task/owned")
+    broker = CommandBroker({"server": {"state_dir": str(tmp_path / "state")}})
+    broker.set_task_store(task_store)
+
+    result = broker.stash_save(str(registered), task_id="task-owned")
+
+    assert result["success"] is False
+    assert result["mutation_worktree_required"] is True
+    assert "Git identity changed" in result["error"]
