+        result = broker.stash_restore(str(shared), task_id="task-owned")
+    else:
+        result = broker.diff_hunk_stage(
+            str(shared),
+            "diff --git a/file.txt b/file.txt\nindex 1111111..2222222 100644\n--- a/file.txt\n+++ b/file.txt\n@@ -1 +1 @@\n-old\n+new\n",
