+def test_git_mutation_helpers_work_inside_registered_task_worktree(tmp_path: Path) -> None:
+    def git(*args: str) -> subprocess.CompletedProcess[str]:
+        return subprocess.run(
+            ["git", *args], cwd=str(tmp_path), capture_output=True,
+            text=True, check=True, **hidden_run_kwargs()
+        )
+
+    git("init")
+    git("config", "user.name", "Test")
+    git("config", "user.email", "test@example.com")
+    tracked = tmp_path / "tracked.txt"
+    tracked.write_text("before\n", encoding="utf-8")
+    git("add", tracked.name)
+    git("commit", "-m", "initial")
+
+    broker = CommandBroker({"server": {"state_dir": str(tmp_path / "state")}})
+    broker.set_task_store(_FakeTaskStore(str(tmp_path)))
+    tracked.write_text("staged\n", encoding="utf-8")
+    patch = git("diff", "--", tracked.name).stdout
+    tracked.write_text("before\n", encoding="utf-8")
+
+    staged = broker.diff_hunk_stage(str(tmp_path), patch, task_id="task-owned")
+    assert staged["success"] is True, {**staged, "patch": patch}
+    assert git("diff", "--cached", "--name-only").stdout.strip() == tracked.name
+    git("reset", "HEAD", "--", tracked.name)
+    tracked.write_text("dirty\n", encoding="utf-8")
+    saved = broker.stash_save(str(tmp_path), "safe message", task_id="task-owned")
+    assert saved["success"] is True
+    assert saved["stashed"] is True
+    restored = broker.stash_restore(str(tmp_path), task_id="task-owned")
+    assert restored["success"] is True
+    assert tracked.read_text(encoding="utf-8") == "dirty\n"
+
