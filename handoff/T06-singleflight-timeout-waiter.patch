--- a/tests/test_command_timeout_cache_contract.py
+++ b/tests/test_command_timeout_cache_contract.py
@@ -1,4 +1,7 @@
 from __future__ import annotations
+
+import threading
+import time
 
 import pytest
 
@@ -47,3 +50,72 @@
     assert second["cache_hit"] is False
     assert len(executions) == 2
