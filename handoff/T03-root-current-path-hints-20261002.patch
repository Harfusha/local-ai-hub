diff --git a/tests/test_t03_path_hint_search_first.py b/tests/test_t03_path_hint_search_first.py
new file mode 100644
--- /dev/null
+++ b/tests/test_t03_path_hint_search_first.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from local_ai_hub.project_config import PathHint
+from local_ai_hub.repo_tools import RepositoryTools
+from local_ai_hub.services import LocalAIServices
+
+
+def _search_service(root: Path) -> LocalAIServices:
+    config = {
+        "server": {"state_dir": str(root / ".state")},
+        "rag": {"extensions": [".py"]},
+        "search": {
+            "prefer_git_files": False,
+            "use_git_grep_fallback": False,
+            "use_ripgrep_if_available": False,
+            "max_files": 32,
+            "max_hits": 20,
+        },
+    }
+    services = LocalAIServices.__new__(LocalAIServices)
+    services.config = config
+    services.learner = None
+    services.deterministic = None
+    services.code_index = None
+    services.preprocessor = None
+    services.repo_tools = RepositoryTools(config)
+    services.repo_tools._ripgrep_candidates = lambda *_args, **_kwargs: (None, False)
+    services.repo_tools._git_grep_candidates = lambda *_args, **_kwargs: (None, False)
+    services.evidence_store = None
+    services._repo_cache_state = lambda _root: {"fingerprint": "fixture-rev", "kind": "fixture"}
+    services._repo_cached = lambda _operation, _root, _params, compute: compute()
+    return services
+
+
+def test_valid_hint_search_first_keeps_quality_and_reads_fewer_files(tmp_path: Path) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / "tests").mkdir()
+    (tmp_path / "docs").mkdir()
+    (tmp_path / "src" / "auth.py").write_text("def verify_token(value):\n    return value == 'ok'\n", encoding="utf-8")
+    (tmp_path / "src" / "other.py").write_text("VALUE = 1\n", encoding="utf-8")
+    (tmp_path / "tests" / "test_auth.py").write_text("def test_other():\n    assert True\n", encoding="utf-8")
+    (tmp_path / "docs" / "notes.py").write_text("NOTE = 'unrelated'\n", encoding="utf-8")
+    services = _search_service(tmp_path)
+
+    baseline = services.repo_search(str(tmp_path), "verify_token", top_k=1)
+    hinted = services.repo_search(
+        str(tmp_path),
+        "verify_token",
+        top_k=1,
+        path_hints=[PathHint(path="src/auth.py", purpose="repository_search", scope="repo_search")],
+    )
+
+    assert baseline["success"] and hinted["success"]
+    assert [hit["path"] for hit in baseline["results"]] == ["src/auth.py"]
+    assert [hit["path"] for hit in hinted["results"]] == ["src/auth.py"]
+    assert baseline["scanned_files"] == 4
+    assert hinted["scanned_files"] == 1
+
+
+def test_hint_miss_or_stale_hint_falls_back_to_full_search(tmp_path: Path) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / "src" / "target.py").write_text("def find_needle():\n    return 'needle'\n", encoding="utf-8")
+    (tmp_path / "src" / "empty.py").write_text("VALUE = 'unrelated'\n", encoding="utf-8")
+    (tmp_path / "docs.py").write_text("NOTE = 'unrelated'\n", encoding="utf-8")
+    services = _search_service(tmp_path)
+    hints = [
+        PathHint(path="src/empty.py", purpose="repository_search", scope="repo_search"),
+        PathHint(
+            path="src/target.py", purpose="repository_search", scope="repo_search",
+            repository_revision="stale-revision",
+        ),
+    ]
+
+    for hint in hints:
+        result = services.repo_search(str(tmp_path), "needle", top_k=1, path_hints=[hint])
+        assert result["success"]
+        assert [hit["path"] for hit in result["results"]] == ["src/target.py"]
+        assert result["scanned_files"] == 3
+
+
+def test_excluded_and_out_of_root_hints_fall_back_without_leaking_results(tmp_path: Path) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / "secret").mkdir()
+    (tmp_path / "src" / "allowed.py").write_text("needle\n", encoding="utf-8")
+    (tmp_path / "secret" / "blocked.py").write_text("needle\n", encoding="utf-8")
+    (tmp_path / ".local-ai.toml").write_text('exclude_paths = ["secret/**"]\n', encoding="utf-8")
+    outside = tmp_path.parent / f"{tmp_path.name}-outside.py"
+    outside.write_text("needle\n", encoding="utf-8")
+    services = _search_service(tmp_path)
+    try:
+        hints = [
+            PathHint(path="secret/blocked.py", purpose="repository_search", scope="repo_search"),
+            PathHint(path="../" + outside.name, purpose="repository_search", scope="repo_search"),
+        ]
+        for hint in hints:
+            result = services.repo_search(str(tmp_path), "needle", top_k=1, path_hints=[hint])
+            assert result["success"]
+            assert [hit["path"] for hit in result["results"]] == ["src/allowed.py"]
+    finally:
+        outside.unlink(missing_ok=True)
