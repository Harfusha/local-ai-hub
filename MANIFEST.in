include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include FEATURES.md
include README.md
include RELEASE.json
include SECURITY.md
include THIRD_PARTY.md
include LICENSE
include config.toml.example
include defaults.toml
include requirements-core.txt
include requirements-token-economy.txt
include requirements-local-nlp.txt
include requirements-openvino.txt
include install.ps1
include install.sh
recursive-include tools *.py
include tools/release-build-requirements.txt
include tools/release-pip-requirements.txt
include tools/release-runtime-constraints.txt
recursive-include browser_bridge *
recursive-include skills *
recursive-include tests *.py
recursive-include .github *.yml
prune build
prune dist
prune data
prune generated
prune .handoff
prune .merge-checks
prune artifacts
prune T18-review-artifacts-*
prune .t03-root-current-overlay
prune .t*-overlay*

recursive-include docs *.md
prune docs/superpowers
exclude docs/integration-*.md
prune docs/integration
exclude docs/*SYNC*.md docs/*STASH*.md docs/*WORKTREE*.md docs/PRIORITY_STASH*.md
exclude docs/T*SYNC*.md docs/T*HANDOFF*.md docs/T*FILES*.txt
