+            return {"success": True}
+
+    class Incidents:
+        def resolve_all(self, *, verified_fix, root_cause, timeout_seconds):
+            captured["incidents"] = timeout_seconds
+            return 0
+
+    service = object.__new__(LocalAIServices)
